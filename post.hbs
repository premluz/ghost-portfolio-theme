{{!< default}}

{{!-- Sticky Section Navigation (outside article for proper positioning) 
<nav class="sticky-nav" data-auto-generate="true" data-content-selector=".gh-content" data-heading-selector="h2" aria-label="Post sections"></nav>
--}}
{{#post}}

<article class="post" data-post-hero="contained" data-post-id="{{id}}" data-post-tags="{{#foreach tags}}{{slug}}{{#unless @last}},{{/unless}}{{/foreach}}">
  {{!-- .post-header-layout is the two-column row: .post-project-summary
        (col 1) beside .post-header (col 2 — EVERYTHING else: title/
        category/excerpt/meta, the feature image, and the logomark all
        stack normally inside it). This replaces an earlier attempt
        (.post-header-row) that put the summary INSIDE .post-header
        alongside just the title block, with the image forced below
        spanning full width — that read as the summary sitting next to
        the title only, not next to the whole header. .logomark-container
        lives here too (not inside .post-header): its CSS positions it
        with `right: calc((100% - 1280px) / 2 + ...)`, which assumes 100%
        = the full page-width column: correct when its containing block
        is .post-header-layout (this element), wrong (narrower) if it
        were .post-header, now a flex:1 child sharing the row with the
        260px sidebar. --}}
  <div class="post-header-layout">
    {{!-- Role/contributions summary from projectMeta (post code injection)
          — dedicated .role-overview classes (not the shared .flexlayout
          card pattern, and not the old .flexlayout2/.col markup, which had
          no matching CSS at all). order:-1 (main.css) moves this column
          before .post-header visually without reordering the DOM — H1
          stays the first reading-order heading for accessibility/SEO.
          Hidden by default (main.css); displayProjectMetadata() below
          reveals it only once meta.role/meta.contributions actually
          exist. --}}
    <div class="post-project-summary mt-0 mb-0 mr-0 ml-0 kg-width-wide" style="padding:0;" id="post-project-summary">
      <div class="role-overview">
        <div class="role-overview-block">
          <span class="text-eyebrow">My Role</span>
          <div class="post-project-role" id="post-project-role"></div>
        </div>
        <div class="role-overview-block">
          <span class="text-eyebrow">What I owned</span>
          <div class="post-project-contributions" id="post-project-contributions"></div>
        </div>
      </div>
    </div>

    <header class="post-header">
      <div class="container">
        <div class="post-header-content">
          {{!-- Project category from projectMeta --}}
          <p class="post-category text-eyebrow" id="project-category"></p>
          <h1 class="post-title">{{title}}</h1>
          {{!-- Project client name --}}
          <!--<p class="post-client" id="project-client"></p>-->
          {{!-- Project result --}}
        <!--  <div class="post-result" id="project-result"></div>-->
          {{#if custom_excerpt}}
            <p class="post-excerpt">{{custom_excerpt}}</p>
          {{/if}}

          <div class="post-meta">
            <!--<time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMM DD, YYYY"}}</time>-->
            {{!-- Keywords pills from projectMeta --}}
            <div class="post-keywords" id="post-keywords"></div>
           <!-- {{#if reading_time}}
              <span class="reading-time">{{reading_time}}</span>
            {{/if}}-->
          </div>
        </div>
      </div>

      {{#if feature_image}}
        <figure class="post-image">
          <img src="{{feature_image}}" alt="{{title}}" loading="lazy" data-skip-reveal>
        </figure>
      {{/if}}
    </header>

    {{!-- Project logomark container --}}
    <div class="logomark-container" id="logomark-container">
      <img class="logomark-image" id="logomark-image" alt="Project logo" />
      {{!-- Populated from meta.date, revealed letter-by-letter only once
            the logomark's drop/bounce (main.js animateLogomarkDrop) has
            actually finished — see the logomarkDropComplete listener
            below, not a fixed delay guess. --}}
      <p class="logomark-date" id="logomark-date"></p>
    </div>
  </div>

  {{!-- Table of Contents --}}
  <aside class="post-toc" aria-label="Table of contents">
    <button class="post-toc-toggle" aria-expanded="false" aria-controls="post-toc-list">
      <span class="post-toc-icon">☰</span>
    </button>
    <nav class="post-toc-nav" id="post-toc-list" aria-hidden="true">
      <ul class="post-toc-list"></ul>
    </nav>
  </aside>

  <div class="gh-canvas" data-page-content-width="contained">
    <div class="gh-content">
      {{content}}
    </div>
  </div>

  <footer class="post-footer">
  </footer>

  {{!-- {{> post-navigation}} — commented out per request --}}
</article>

{{!-- Project metadata display script (runs after content) --}}
<script>
  function displayProjectMetadata() {
    // Support both projectMeta (object) and projectMetaArray (array)
    let meta = null;

    if (window.projectMetaArray && Array.isArray(window.projectMetaArray) && window.projectMetaArray.length > 0) {
      meta = window.projectMetaArray[0];
      console.log('[metadata] Using projectMetaArray[0]:', meta);
    } else if (window.projectMeta && Object.keys(window.projectMeta).length > 0) {
      meta = window.projectMeta;
      console.log('[metadata] Using projectMeta:', meta);
    }

    if (!meta || Object.keys(meta).length === 0) {
      console.log('[metadata] No projectMeta/projectMetaArray configured.');
      return;
    }

    if (meta.projectCategory) {
      const categoryEl = document.getElementById('project-category');
      if (categoryEl) {
        categoryEl.textContent = meta.projectCategory;
        categoryEl.style.display = 'block';
        console.log('[metadata] Set projectCategory:', meta.projectCategory);
      }
    }

    if (meta.client) {
      const clientEl = document.getElementById('project-client');
      if (clientEl) {
        clientEl.textContent = meta.client;
        console.log('[metadata] Set client:', meta.client);
      }
    }

    if (meta.result) {
      const resultEl = document.getElementById('project-result');
      if (resultEl) {
        resultEl.innerHTML = meta.result;
        console.log('[metadata] Set result:', meta.result);
      }
    }

    // Comma-separated values each render as their own <p> — same convention
    // as meta.cardKeywords elsewhere (main.js), just paragraphs instead of
    // pill spans since these read as short statements, not tags.
    const renderCommaListAsParagraphs = (container, value) => {
      const parts = value.split(',').map(v => v.trim()).filter(v => v.length > 0);
      container.innerHTML = parts.map(part => `<p>${part}</p>`).join('');
      return parts.length > 0;
    };

    const summaryEl = document.getElementById('post-project-summary');
    const roleEl = document.getElementById('post-project-role');
    const contributionsEl = document.getElementById('post-project-contributions');
    let hasSummaryContent = false;

    if (meta.role && roleEl) {
      hasSummaryContent = renderCommaListAsParagraphs(roleEl, meta.role) || hasSummaryContent;
      console.log('[metadata] Set role:', meta.role);
    }

    if (meta.contributions && contributionsEl) {
      hasSummaryContent = renderCommaListAsParagraphs(contributionsEl, meta.contributions) || hasSummaryContent;
      console.log('[metadata] Set contributions:', meta.contributions);
    }

    if (summaryEl && hasSummaryContent) {
      summaryEl.style.display = 'block';
      console.log('[metadata] Made post-project-summary visible');
    }

    const containerEl = document.getElementById('logomark-container');
    const logomarkEl = document.getElementById('logomark-image');

    if (meta.logomark && logomarkEl) {
      // Handle relative paths by constructing full URL
      let logomarkUrl = meta.logomark;
      if (logomarkUrl.startsWith('/')) {
        logomarkUrl = window.location.origin + logomarkUrl;
      }
      logomarkEl.src = logomarkUrl;
      console.log('[metadata] Set logomark:', logomarkUrl);
    }

    // Handle accentColor (both camelCase and kebab-case)
    const accentColor = meta.accentColor || meta['accent-color'];
    if (accentColor && containerEl) {
      containerEl.style.backgroundColor = accentColor;
      console.log('[metadata] Set accentColor:', accentColor);
    }

    // Make container visible if either logomark or color is set
    if (containerEl && (meta.logomark || accentColor)) {
      containerEl.style.visibility = 'visible';
      containerEl.style.opacity = '1';
      console.log('[metadata] Made logomark container visible');
    }

    // Date: text is set now, but NOT revealed yet — kept invisible until
    // the logomarkDropComplete event (dispatched by main.js's
    // animateLogomarkDrop() when its bounce timeline actually finishes),
    // not a fixed delay guess that could fire before/after the real drop.
    if (meta.date) {
      const dateEl = document.getElementById('logomark-date');
      if (dateEl) {
        dateEl.dataset.pendingText = meta.date;
        console.log('[metadata] Queued date for reveal after logomark drop:', meta.date);
        tryRevealLogomarkDate(); // in case the drop already finished before metadata arrived
      }
    }

    // Handle disable-link (both camelCase and kebab-case)
    const disableLink = meta.disableLink || meta['disable-link'];
    if (disableLink === true) {
      // On post detail pages, we can't disable the entire post
      // Instead, this would be used on post cards/homepage
      console.log('[metadata] disable-link flag set (applies to post cards, not detail page)');
    }
  }

  // Letter-by-letter reveal for the date under the logomark — gated on
  // BOTH conditions being true (meta.date having arrived AND the drop
  // animation having actually finished), whichever order they happen to
  // resolve in; either side calls this and it only fires once both are met.
  // Declared here, BEFORE waitForMeta()'s invocation below: if
  // window.projectMeta is already set by the time this script runs,
  // waitForMeta() calls displayProjectMetadata() synchronously, which calls
  // tryRevealLogomarkDate() — referencing logomarkDropDone before it was
  // declared threw "Cannot access before initialization" and silently
  // aborted the rest of this script's execution, including the
  // logomarkDropComplete listener below ever getting registered at all.
  let logomarkDropDone = false;
  function tryRevealLogomarkDate() {
    const dateEl = document.getElementById('logomark-date');
    if (!dateEl || !logomarkDropDone) return;
    if (!dateEl.dataset.pendingText || dateEl.dataset.revealed === 'true') return;
    dateEl.dataset.revealed = 'true';

    const text = dateEl.dataset.pendingText;
    dateEl.innerHTML = '';
    const chars = Array.from(text).map((ch) => {
      const span = document.createElement('span');
      span.className = 'char';
      // Spaces get their own span too (so layout/spacing is correct) but
      // start fully visible — there's no glyph to fade in, and skipping
      // the span entirely was the exact bug that ran words together
      // elsewhere on this site (scroll-scrub-anim.js's splitText()).
      span.style.opacity = ch.trim() ? '0' : '1';
      span.textContent = ch;
      dateEl.appendChild(span);
      return span;
    });

    if (window.gsap) {
      gsap.to(chars, { opacity: 1, duration: 0.05, stagger: 0.03, ease: 'power1.out' });
    } else {
      chars.forEach((c) => { c.style.opacity = '1'; });
    }
  }

  // Wait for projectMeta or projectMetaArray to be defined (set in post code injection)
  // Named metaWaitAttempts (not attempts) — plain classic <script> tags share
  // one global lexical scope for let/const, and particle-morph.hbs (included
  // globally by default.hbs) declares its own top-level `let attempts` for an
  // unrelated retry loop. Two scripts on the same page both declaring
  // `let attempts` throws a SyntaxError that silently kills BOTH scripts
  // entirely, including particle-morph's post-page exclusion check.
  let metaWaitAttempts = 0;
  const waitForMeta = () => {
    const hasProjectMeta = window.projectMeta && Object.keys(window.projectMeta).length > 0;
    const hasProjectMetaArray = window.projectMetaArray && Array.isArray(window.projectMetaArray) && window.projectMetaArray.length > 0;

    if (hasProjectMeta || hasProjectMetaArray) {
      displayProjectMetadata();
      return;
    }
    metaWaitAttempts++;
    if (metaWaitAttempts < 50) {
      setTimeout(waitForMeta, 50);
    }
  };
  waitForMeta();

  // Dispatched by main.js's animateLogomarkDrop() when its bounce timeline
  // actually completes — same cross-script event pattern already used for
  // heroEntranceDone, rather than guessing a fixed delay that could fire
  // before/after the real drop finishes.
  document.addEventListener('logomarkDropComplete', () => {
    logomarkDropDone = true;
    tryRevealLogomarkDate();
  });
</script>

{{!-- Testimonial metadata display script (runs after content) --}}
<script>
  function displayTestimonialMetadata() {
    // testimonialMeta should be set via post codeinjection_head in Ghost admin
    if (!window.testimonialMeta || Object.keys(window.testimonialMeta).length === 0) {
      console.log('[testimonial] No testimonialMeta configured. Add a script to post codeinjection_head in Ghost admin.');
      return;
    }

    const meta = window.testimonialMeta;
    console.log('[testimonial] Found testimonialMeta:', meta);

    // Display snippet on testimonial detail page if available
    if (meta.snippet) {
      const snippetEl = document.getElementById('testimonial-snippet');
      if (snippetEl) {
        snippetEl.textContent = meta.snippet;
        snippetEl.style.display = 'block';
        console.log('[testimonial] Set snippet:', meta.snippet);
      }
    }

    // Display source on testimonial detail page if available
    if (meta.source) {
      const sourceEl = document.getElementById('testimonial-source');
      if (sourceEl) {
        sourceEl.textContent = meta.source;
        sourceEl.style.display = 'block';
        console.log('[testimonial] Set source:', meta.source);
      }
    }

    // Display short on testimonial detail page if available
    if (meta.short) {
      const shortEl = document.getElementById('testimonial-short');
      if (shortEl) {
        shortEl.textContent = meta.short;
        shortEl.style.display = 'block';
        console.log('[testimonial] Set short:', meta.short);
      }
    }

    // Display full on testimonial detail page if available
    if (meta.full) {
      const fullEl = document.getElementById('testimonial-full');
      if (fullEl) {
        fullEl.innerHTML = meta.full;
        fullEl.style.display = 'block';
        console.log('[testimonial] Set full:', meta.full);
      }
    }
  }

  // Wait for testimonialMeta to be defined (set in post code injection)
  let testimonialAttempts = 0;
  const waitForTestimonialMeta = () => {
    if (window.testimonialMeta && Object.keys(window.testimonialMeta).length > 0) {
      displayTestimonialMetadata();
      return;
    }
    testimonialAttempts++;
    if (testimonialAttempts < 50) {
      setTimeout(waitForTestimonialMeta, 50);
    }
  };
  waitForTestimonialMeta();
</script>

{{/post}}
