{{!-- Project metadata display script (runs after content) --}}
<script>
  function displayProjectMetadata() {
    // Support both projectMeta (object) and projectMetaArray (array)
    let meta = null;

    if (window.projectMetaArray && Array.isArray(window.projectMetaArray) && window.projectMetaArray.length > 0) {
      meta = window.projectMetaArray[0];
      console.log('[metadata] Using projectMetaArray[0]:', meta);
    } else if (window.projectMeta && Object.keys(window.projectMeta).length > 0) {
      meta = window.projectMeta;
      console.log('[metadata] Using projectMeta:', meta);
    }

    if (!meta || Object.keys(meta).length === 0) {
      console.log('[metadata] No projectMeta/projectMetaArray configured.');
      return;
    }

    // Post-header meta column (Client / Category / Timeline / Skills) —
    // each row is .post-header-meta-row[data-field] wrapping a
    // .text-eyebrow label + a value <p> (post.hbs markup). A field with no
    // value hides its OWN row entirely (same "hide, don't leave an empty
    // labeled row" contract the role-overview fields below already use),
    // rather than the old approach of forcing the value element's own
    // display — that fought a flex/grid row's own layout role once this
    // became a real row instead of a single free-floating <p>.
    const headerMetaFields = [
      ['client', 'project-client'],
      ['projectCategory', 'project-category'],
      ['timeline', 'project-timeline'],
      ['skills', 'project-skills'],
      ['date', 'project-date'],
      ['scope', 'project-scope'],
    ];
    headerMetaFields.forEach(([key, elId]) => {
      const valueEl = document.getElementById(elId);
      if (!valueEl) return;
      const row = valueEl.closest('.post-header-meta-row');
      const value = meta[key];
      if (value) {
        valueEl.textContent = value;
        if (row) row.style.display = '';
        console.log('[metadata] Set ' + key + ':', value);
      } else if (row) {
        row.style.display = 'none';
      }
    });

    // Stagger fade-in for .post-header-meta-row, same shape as the
    // (dead, see .post-side's own doc) .role-overview-block stagger
    // further below (opacity + y + scale + blur, SCROLL_REVEAL_CONFIG.
    // card.default) — kept as its own separate block rather than
    // sharing that one's summaryEl/hasSummaryContent gate: unlike
    // .post-side (a whole block that's either fully shown or fully
    // hidden), .post-header-meta is ALWAYS present in the header — only
    // individual ROWS toggle visibility above, per field. Selecting
    // rows AFTER the display:none loop above means only whichever rows
    // ended up actually visible for THIS post get animated; a row
    // that's display:none never becomes part of the GSAP target set, so
    // there's nothing to reveal for an empty field.
    const headerMetaRows = Array.from(document.querySelectorAll('.post-header-meta-row'))
      .filter((row) => row.style.display !== 'none');
    const revealHeaderMetaRows = () => {
      if (!headerMetaRows.length) return;
      const cfg = window.SCROLL_REVEAL_CONFIG.card.default;
      gsap.set(headerMetaRows, { opacity: 0, y: cfg.yOffset, scale: cfg.scale.start });
      gsap.to(headerMetaRows, {
        opacity: 1,
        y: 0,
        scale: cfg.scale.end,
        filter: `blur(${cfg.blur.end}px)`,
        duration: cfg.duration,
        ease: cfg.ease,
        stagger: cfg.staggerDelay,
      });
    };
    if (window.gsap && window.SCROLL_REVEAL_CONFIG) {
      revealHeaderMetaRows();
    } else {
      // Same "GSAP loads later in the page than this inline script"
      // situation the role-overview-block stagger below already
      // documents — headerMetaGsapWaitAttempts (not
      // attempts/metaWaitAttempts/gsapWaitAttempts) for the same shared-
      // top-level-scope reason those two already use distinct names.
      let headerMetaGsapWaitAttempts = 0;
      const waitForHeaderMetaGsap = () => {
        if (window.gsap && window.SCROLL_REVEAL_CONFIG) { revealHeaderMetaRows(); return; }
        headerMetaGsapWaitAttempts++;
        if (headerMetaGsapWaitAttempts < 50) setTimeout(waitForHeaderMetaGsap, 50);
        else headerMetaRows.forEach((r) => { r.style.opacity = '1'; });
      };
      waitForHeaderMetaGsap();
    }

    if (meta.result) {
      const resultEl = document.getElementById('project-result');
      if (resultEl) {
        resultEl.innerHTML = meta.result;
        console.log('[metadata] Set result:', meta.result);
      }
    }

    // Semicolon-separated values each render as their own <p> — same
    // convention as meta.cardKeywords elsewhere (main.js), just paragraphs
    // instead of pill spans since these read as short statements, not tags.
    // Commas are left as normal text within a part (not a delimiter).
    const renderCommaListAsParagraphs = (container, value) => {
      const parts = value.split(';').map(v => v.trim()).filter(v => v.length > 0);
      container.innerHTML = parts.map(part => `<p>${part}</p>`).join('');
      return parts.length > 0;
    };

    const summaryEl = document.getElementById('post-project-summary');
    let hasSummaryContent = false;

    // Each field's .role-overview-block (the value element's own parent —
    // see post.hbs markup) is hidden entirely when that field has no data,
    // rather than rendering an empty block with just its eyebrow label and
    // nothing under it.
    const roleOverviewFields = [
      ['date', 'post-project-date'],
      ['role', 'post-project-role'],
      ['team', 'post-project-team'],
      ['contributions', 'post-project-contributions'],
      ['context', 'post-project-context'],
    ];

    roleOverviewFields.forEach(([key, elId]) => {
      const el = document.getElementById(elId);
      if (!el) return;
      const block = el.closest('.role-overview-block');
      const value = meta[key];
      const hasContent = value ? renderCommaListAsParagraphs(el, value) : false;
      if (hasContent) {
        hasSummaryContent = true;
        if (block) block.style.display = '';
        console.log('[metadata] Set ' + key + ':', value);
      } else if (block) {
        block.style.display = 'none';
      }
    });

    if (summaryEl && hasSummaryContent) {
      summaryEl.style.display = 'block';
      // Gates .post-layout's desktop two-column grid (main.css) — without
      // this the side rail's 260px column is reserved even on posts with
      // no projectMeta at all, pushing the content off-centre.
      document.querySelector('.post-layout')?.classList.add('has-side');
      console.log('[metadata] Made post-project-summary visible');

      // Stagger fade-in for the role-overview-block children — same shape
      // as every other reveal on this site (opacity + y + scale + blur, see
      // SCROLL_REVEAL_CONFIG.card.default), just triggered immediately on
      // data arrival rather than a scroll observer: this section sits in
      // the post header, already in view the moment it's populated.
      const roleBlocks = summaryEl.querySelectorAll('.role-overview-block');
      const revealRoleBlocks = () => {
        if (!roleBlocks.length) return;
        const cfg = window.SCROLL_REVEAL_CONFIG.card.default;
        gsap.set(roleBlocks, { opacity: 0, y: cfg.yOffset, scale: cfg.scale.start });
        gsap.to(roleBlocks, {
          opacity: 1,
          y: 0,
          scale: cfg.scale.end,
          filter: `blur(${cfg.blur.end}px)`,
          duration: cfg.duration,
          ease: cfg.ease,
          stagger: cfg.staggerDelay,
        });
      };
      if (window.gsap && window.SCROLL_REVEAL_CONFIG) {
        revealRoleBlocks();
      } else {
        // GSAP loads via a <script> tag further down the page than this
        // inline block (default.hbs: {{{body}}} at line 346, GSAP at 401)
        // — when metadata resolves synchronously (codeinjection_head
        // embeds it directly, so waitForMeta's first check already
        // succeeds), this runs before that tag has executed. Poll briefly
        // rather than falling straight through to no animation at all.
        // gsapWaitAttempts (not attempts/metaWaitAttempts) — see the
        // comment on metaWaitAttempts below re: shared top-level scope.
        let gsapWaitAttempts = 0;
        const waitForGsap = () => {
          if (window.gsap && window.SCROLL_REVEAL_CONFIG) { revealRoleBlocks(); return; }
          gsapWaitAttempts++;
          if (gsapWaitAttempts < 50) setTimeout(waitForGsap, 50);
          else roleBlocks.forEach((b) => { b.style.opacity = '1'; });
        };
        waitForGsap();
      }
    }

    const containerEl = document.getElementById('logomark-container');
    const logomarkEl = document.getElementById('logomark-image');

    if (meta.logomark && logomarkEl) {
      // Handle relative paths by constructing full URL
      let logomarkUrl = meta.logomark;
      if (logomarkUrl.startsWith('/')) {
        logomarkUrl = window.location.origin + logomarkUrl;
      }
      logomarkEl.src = logomarkUrl;
      console.log('[metadata] Set logomark:', logomarkUrl);
    }

    // Handle accentColor (both camelCase and kebab-case)
    const accentColor = meta.accentColor || meta['accent-color'];
    if (accentColor && containerEl) {
      containerEl.style.backgroundColor = accentColor;
      console.log('[metadata] Set accentColor:', accentColor);
    }
    // Also feeds --before-after-accent (before-after-slider.css) — the
    // before/after slider is a standalone module pasted into content via
    // an HTML card, with no direct access to this post's own metadata,
    // so it reads accentColor the same indirect way textGradientColor
    // reaches .text-gradient: a CSS custom property set here on
    // documentElement, consumed by that module's own stylesheet with a
    // fallback for any page where accentColor isn't set at all.
    if (accentColor) {
      document.documentElement.style.setProperty('--before-after-accent', accentColor);
    }

    // ── Per-mode metadata resolution ────────────────────────────────────
    // Every colour field below accepts an optional per-theme variant
    // alongside its existing mode-agnostic form:
    //     textGradientColor       (both modes — existing, unchanged)
    //     textGradientColorLight  (light only)   } new, optional
    //     textGradientColorDark   (dark only)    }
    // Resolution is "specific wins, generic falls back", so every post
    // authored before this existed keeps behaving exactly as it did.
    // Both camelCase and kebab-case are accepted throughout, matching the
    // convention accentColor above already established.
    //
    // 'dim' resolves to the Dark variant, not its own: dim inherits dark's
    // gradient stops in tokens.css (see the note in its :root block there),
    // so a separate dimmed override here would contradict the token layer.
    function currentMode() {
      return document.documentElement.getAttribute('data-theme') === 'light' ? 'Light' : 'Dark';
    }
    function metaForMode(baseKey) {
      const mode = currentMode();                              // 'Light' | 'Dark'
      const kebab = baseKey.replace(/[A-Z]/g, (m) => '-' + m.toLowerCase());
      return meta[baseKey + mode]
          || meta[kebab + '-' + mode.toLowerCase()]
          || meta[baseKey]
          || meta[kebab];
    }

    // textGradientColor — per-post override of .text-gradient's fill
    // (main.css .text-gradient utility, background-clip:text). The
    // class itself never changes per post; the gradient is driven by CSS
    // custom properties (tokens.css), so overriding those on
    // documentElement is enough for every .text-gradient element on the
    // page to pick up this post's own color with zero markup changes —
    // same "one shared class, per-post CSS variable override" shape
    // accentColor above already uses, just targeting a gradient fill
    // instead of a flat background-color.
    // Comma-separated hex list, same format/parsing convention as
    // gradientCss below (not a literal linear-gradient(...) string) —
    // one consistent "just list your colors" authoring format across
    // every per-post color field on this page, rather than requiring
    // full CSS gradient syntax in codeinjection_head. 100deg + the
    // 28%/74%/100% stop positions match --gradient-text-image's own
    // default shape in tokens.css exactly; only the colors change.
    //
    // Sets BOTH the --grad-text-1/2/3 primitives and the composed
    // --gradient-text-image string, on purpose. Primitives alone would be
    // enough in dark (where tokens.css composes the string from them via
    // var()), but NOT in light — light keeps its own direct 5-stop
    // --gradient-text-image override, which would outrank the primitives
    // and silently ignore this post's colours. Writing the composed string
    // too covers both; writing the primitives too keeps anything reading
    // the raw stops (gradient-tokens.js) correct rather than stale.
    function applyTextGradient() {
      const textGradientColor = metaForMode('textGradientColor');
      if (!textGradientColor) return;
      const stops = textGradientColor.split(',').map((c) => c.trim()).filter(Boolean);
      if (!stops.length) return;
      let image;
      if (stops.length === 1) {
        image = `linear-gradient(100deg, ${stops[0]} 0%, ${stops[0]} 100%)`;
      } else if (stops.length === 2) {
        image = `linear-gradient(100deg, ${stops[0]} 28%, ${stops[1]} 100%)`;
      } else {
        image = `linear-gradient(100deg, ${stops[0]} 28%, ${stops[1]} 74%, ${stops[2]} 100%)`;
      }
      const root = document.documentElement.style;
      root.setProperty('--gradient-text-image', image);
      // Pad a short list by repeating the last stop, so all three
      // primitives always describe the same gradient the string above does
      // (a 1-stop post shouldn't leave stale stops 2/3 from another post).
      root.setProperty('--grad-text-1', stops[0]);
      root.setProperty('--grad-text-2', stops[1] || stops[0]);
      root.setProperty('--grad-text-3', stops[2] || stops[1] || stops[0]);
      console.log('[metadata] Set text-gradient colors (' + currentMode() + '):', stops);
    }
    applyTextGradient();

    // Progress bar (the loading streak AND the scroll indicator — one
    // shared .scroll-progress.progress-bar-track element, default.hbs).
    // -a is left alone entirely: its CSS fallback (main.css) is
    // --color-background, the theme's own bg token — already responsive to
    // dark/light/dim with zero JS, no per-post override wanted here.
    // -b is this post's accentColor when set (mode-agnostic — accentColor
    // has no Light/Dark variant anywhere else in this file either, see the
    // block above that first reads it), falling back to the theme's
    // --color-secondary (main.css) otherwise. No re-resolve needed on
    // themechange: accentColor doesn't change per mode, and -a is pure CSS.
    function applyProgressBarColors() {
      if (!accentColor) return;
      document.documentElement.style.setProperty('--progress-bar-color-b', accentColor);
      console.log('[metadata] Set progress bar accent:', accentColor);
    }
    applyProgressBarColors();

    // Per-post hero gradient colors, reusing the same gradientCss field the
    // (currently-disabled) card gradient systems already use elsewhere on
    // the site (see GRADIENT_SYSTEMS.md) — but this frame is gradient-
    // frame.js's type:"wave", which takes two literal hex colors
    // (data-gradient-wave-a/-b), not a CSS gradient string, so gradientCss
    // here is repurposed as a simple "color1, color2" pair rather than a
    // linear-gradient(...) value. Must be set BEFORE gradient-frame.js's
    // own DOMContentLoaded-timed initAll() reads frame.dataset (main.js is
    // not what mounts frames — gradient-frame.js self-inits site-wide,
    // default.hbs) — this script runs earlier (synchronous body script,
    // resolves as soon as codeinjection_head's projectMetaArray exists),
    // so setting the attribute here is in time.
    // Per-mode variants (gradientCssLight / gradientCssDark) resolve through
    // the same metaForMode() helper as textGradientColor above — see its own
    // comment for the resolution order and why 'dim' maps to Dark.
    if (metaForMode('gradientCss')) {
      const gradientCss = metaForMode('gradientCss');
      const [waveA, waveB] = gradientCss.split(',').map((c) => c.trim());
      const frameEl = document.querySelector('.post-hero-gradient-frame');
      if (frameEl && waveA) {
        frameEl.setAttribute('data-gradient-wave-a', waveA);
        frameEl.setAttribute('data-gradient-wave2-a', waveA);
        if (waveB) {
          frameEl.setAttribute('data-gradient-wave-b', waveB);
          frameEl.setAttribute('data-gradient-wave2-b', waveB);
        }
        console.log('[metadata] Set gradient wave colors:', waveA, waveB);
      }

      // Whole-page gradflow-page-bg (this file, above <article>) colored
      // from the SAME gradientCss field — reuses GradflowColorCrossfade's
      // existing hex-list parser/tone-builder (gradflow-color-crossfade.js,
      // loaded site-wide) rather than re-deriving color1/2/3 by hand a
      // second time in this file. tonesFrom() already handles a
      // short list gracefully (1 stop: synthesizes a darker color2,
      // falls back to the live --color-background for color3; 2 stops:
      // still falls back to --color-background for color3) — same
      // fallback behavior the homepage's per-card crossfade already
      // relies on, so a post whose gradientCss only has 1-2 stops (like
      // the 2-stop pair used above for the wave colors) still gets a
      // sensible 3-tone result here, not an error.
      //
      // TWO things must both be ready before this can run, neither
      // guaranteed yet: window.GradflowColorCrossfade (gradflow-color-
      // crossfade.js loads near the BOTTOM of default.hbs, well after
      // {{{body}}} — this inline script runs synchronously as part of the
      // body, same "script tag further down the page" situation this
      // file's own waitForGsap() already documents) and
      // canvas.__gradflowHandle (that partial's own initGradFlowBackground()
      // .then(), resolves asynchronously after ogl loads). One poll loop
      // checks both rather than nesting two separate waits.
      // bgWaitAttempts: this script's shared top-level scope already has
      // metaWaitAttempts/gsapWaitAttempts (see their own comments on why
      // plain `let attempts` collides site-wide) — same naming reason.
      let bgWaitAttempts = 0;
      const waitForPageBg = () => {
        const bgCanvas = document.querySelector('.gradflow-page-bg-canvas');
        if (window.GradflowColorCrossfade && bgCanvas && bgCanvas.__gradflowHandle) {
          // Re-resolved per call (not the outer `gradientCss` const) so the
          // themechange re-run below picks up this post's OTHER mode variant
          // rather than repainting the first-resolved one.
          const rgbs = window.GradflowColorCrossfade.extractRgbs(metaForMode('gradientCss'));
          if (rgbs.length) {
            const tones = window.GradflowColorCrossfade.tonesFrom(rgbs);
            bgCanvas.__gradflowHandle.setColors(tones);
            console.log('[metadata] Set page background colors (' + currentMode() + '):', tones);
          }
          return;
        }
        bgWaitAttempts++;
        if (bgWaitAttempts < 50) setTimeout(waitForPageBg, 100);
      };
      waitForPageBg();

      // Re-drive on theme toggle. Two independent reasons this is needed,
      // either one sufficient on its own:
      //   1. A post authored with gradientCssLight/gradientCssDark has a
      //      different colour set per mode — without this, the mode the
      //      page happened to load in would stick forever.
      //   2. Even with ONE mode-agnostic gradientCss, tonesFrom()'s color3
      //      falls back to the live --color-background (see its own doc in
      //      gradflow-color-crossfade.js), which changes with the theme —
      //      the same reasoning gradflow-page-bg-trigger.js's own
      //      themechange listener documents for the homepage's cards.
      // Fires setColors() directly (a snap, not a crossfade) to match how
      // this canvas is coloured on this page everywhere else — the
      // crossfader in gradflow-color-crossfade.js is the homepage
      // card-to-card mechanism, not wired up here.
      window.addEventListener('themechange', function () {
        bgWaitAttempts = 0;
        waitForPageBg();
      });
    }

    // Re-resolve on theme toggle — deliberately OUTSIDE the gradientCss
    // block above: a post can set textGradientColorLight/Dark without
    // setting gradientCss at all, and nesting this inside that `if` would
    // leave such a post stuck on whichever mode it loaded in.
    // applyProgressBarColors() is NOT re-run here: accentColor has no
    // Light/Dark variant, so it resolves to the same value regardless of
    // theme, and -a is pure CSS (--color-background) that recomputes on
    // its own the instant data-theme changes — nothing for JS to redrive.
    window.addEventListener('themechange', applyTextGradient);

    // No visibility/opacity handling here anymore — .logomark-container's
    // opacity:0 (main.css) is the entrance animation's OWN pre-reveal
    // state now (initPostHeaderAnimation(), main.js, fades it in with the
    // rest of the header), not a "hide until real data confirms a
    // logomark exists" gate the old absolutely-positioned/GSAP-dropped
    // version needed. Setting opacity:1 here as an inline style — which
    // this metadata script resolves well before the entrance timeline
    // runs (that waits on waitForPreloader()) — would have popped the
    // logo instantly visible and skipped its fade-in entirely.

    // Handle disable-link (both camelCase and kebab-case)
    const disableLink = meta.disableLink || meta['disable-link'];
    if (disableLink === true) {
      // On post detail pages, we can't disable the entire post
      // Instead, this would be used on post cards/homepage
      console.log('[metadata] disable-link flag set (applies to post cards, not detail page)');
    }
  }

  // Wait for projectMeta or projectMetaArray to be defined (set in post code injection)
  // Named metaWaitAttempts (not attempts) — plain classic <script> tags share
  // one global lexical scope for let/const, and particle-morph.hbs (included
  // globally by default.hbs) declares its own top-level `let attempts` for an
  // unrelated retry loop. Two scripts on the same page both declaring
  // `let attempts` throws a SyntaxError that silently kills BOTH scripts
  // entirely, including particle-morph's post-page exclusion check.
  let metaWaitAttempts = 0;
  const waitForMeta = () => {
    const hasProjectMeta = window.projectMeta && Object.keys(window.projectMeta).length > 0;
    const hasProjectMetaArray = window.projectMetaArray && Array.isArray(window.projectMetaArray) && window.projectMetaArray.length > 0;

    if (hasProjectMeta || hasProjectMetaArray) {
      displayProjectMetadata();
      return;
    }
    metaWaitAttempts++;
    if (metaWaitAttempts < 50) {
      setTimeout(waitForMeta, 50);
    }
  };
  waitForMeta();
</script>

{{!-- Testimonial metadata display script (runs after content) --}}
<script>
  function displayTestimonialMetadata() {
    // testimonialMeta should be set via post codeinjection_head in Ghost admin
    if (!window.testimonialMeta || Object.keys(window.testimonialMeta).length === 0) {
      console.log('[testimonial] No testimonialMeta configured. Add a script to post codeinjection_head in Ghost admin.');
      return;
    }

    const meta = window.testimonialMeta;
    console.log('[testimonial] Found testimonialMeta:', meta);

    // Display snippet on testimonial detail page if available
    if (meta.snippet) {
      const snippetEl = document.getElementById('testimonial-snippet');
      if (snippetEl) {
        snippetEl.textContent = meta.snippet;
        snippetEl.style.display = 'block';
        console.log('[testimonial] Set snippet:', meta.snippet);
      }
    }

    // Display source on testimonial detail page if available. innerHTML,
    // not textContent: source can carry a <br /> (e.g. "Name,<br />Title
    // at Company") — textContent would render that tag as literal text.
    if (meta.source) {
      const sourceEl = document.getElementById('testimonial-source');
      if (sourceEl) {
        sourceEl.innerHTML = meta.source;
        sourceEl.style.display = 'block';
        console.log('[testimonial] Set source:', meta.source);
      }
    }

    // Display short on testimonial detail page if available
    if (meta.short) {
      const shortEl = document.getElementById('testimonial-short');
      if (shortEl) {
        shortEl.textContent = meta.short;
        shortEl.style.display = 'block';
        console.log('[testimonial] Set short:', meta.short);
      }
    }

    // Display full on testimonial detail page if available
    if (meta.full) {
      const fullEl = document.getElementById('testimonial-full');
      if (fullEl) {
        fullEl.innerHTML = meta.full;
        fullEl.style.display = 'block';
        console.log('[testimonial] Set full:', meta.full);
      }
    }
  }

  // Wait for testimonialMeta to be defined (set in post code injection)
  let testimonialAttempts = 0;
  const waitForTestimonialMeta = () => {
    if (window.testimonialMeta && Object.keys(window.testimonialMeta).length > 0) {
      displayTestimonialMetadata();
      return;
    }
    testimonialAttempts++;
    if (testimonialAttempts < 50) {
      setTimeout(waitForTestimonialMeta, 50);
    }
  };
  waitForTestimonialMeta();
</script>

