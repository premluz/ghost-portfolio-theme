{{!< default}}
{{> preloader}}
{{!-- gradflow-page-bg: whole-page fixed 'smoke' background (see that
      partial's own doc) — sibling of .home, NOT nested inside it, so its
      z-index:0 competes globally against #page-backdrop/particles instead
      of being trapped inside any stacking context .home might gain later
      (it has none today). Dark purple/near-black palette, homepage-only —
      page-about.hbs keeps the partial's own light pastel default.
      triggered="true": starts invisible, driven by gradflow-page-bg-
      trigger.js off the posts-tabs cards (fade in/out + per-card colors)
      instead of being on for the whole page — see that script's doc. 

{{> gradflow-page-bg
    triggered="true"
    color1r="253" color1g="186" color1b="206"
    color2r="255" color2g="229" color2b="229"
    color3r="250" color3g="250" color3b="248"
    speed="0.5" scale="0.7" noise="0.1"
    type="smoke"}}

--}}

<section class="home">

  {{!-- Hero section — configured via Ghost Admin › Design › Custom Fields --}}


{{> hero }}

    {{!-- Logos scroll section — infinite scrolling client logos --}}



    {{!-- Statement slide — design clarity statement --}}
    {{!-- Sticky outer gives 200vh scroll while section pins at top --}}

   {{!-- Logos ribbon — sticky outer gives 300vh for ribbon scroll --}}




    {{!-- Word animation section — scroll-triggered word drop animation
    {{> word-animation}}--}}

  {{!-- Image stripe — horizontal auto-scrolling cards with variable heights 
  {{> image-stripe stripeId="home-image-stripe"}}--}}


   
    {{!-- Original: {{> operating-model-v2}} --}}


    {{!-- Stats parallax — scrolls in after operating model unpins --}}


  
{{> posts-tabs layoutList="true" itemContent="outside"   filterFeatured="featured:true+tag:hash-work+tag:featured" }}


<div class="invert-wrapper invert-wrapper--page invert-wrapper--full"
 data-shift-bg="#120D1C" data-content-theme="dark-ink" data-invert-scrub>

  {{!-- Bespoke to this section only — do NOT reuse .statement-slide/
        -container/-heading (main.css): those are shared by
        partials/statement-slide.hbs, card-description-statement.hbs,
        operating-model.hbs, work-projects.hbs, image-stripe.hbs and others,
        so changing them here would ripple everywhere. .statement-lab-*
        exists so this "AI experiments" intro can diverge freely. --}}
  <section class="statement-lab-slide">
    {{!-- .statement-lab-outer mirrors .hero-container's own box (width/
          max-width/padding, all driven by body[data-page-width]) so
          .statement-lab-container's 33%-margin-left below resolves against
          the SAME width .hero-content's does — without this wrapper the
          33% was relative to the full-bleed <section>, not the hero's
          page-width-constrained column, and landed ~24px off. --}}
    <div class="statement-lab-outer">
      <div class="statement-lab-container">
        <h2 class="statement-lab-heading text-gradient">AI experiments, <br />explorations</h2>
        <h4 class="mt-0">Deep explorations of subjects I find genuinely interesting, paired with prototypes built in real dev environments.<br /> </h4>
      </div>
    </div>
  </section>

  <div id="work-grid-lab">
  {{> posts-tabs layoutList="true" itemContent="outside"  filterFeatured="featured:true+tag:hash-work+tag:experimental" }}
  </div>
</div>



{{> testimonials }}




    {{!--
  {{#if pagination.next}}
    <div class="pagination">
      <div class="container text-center">
        {{#if pagination.prev}}
          <a href="{{pagination.prev}}" class="pagination-link">← Previous</a>
        {{/if}}
        <span class="pagination-info">Page {{pagination.page}} of {{pagination.pages}}</span>
        {{#if pagination.next}}
          <a href="{{pagination.next}}" class="pagination-link">Next →</a>
        {{/if}}
      </div>
    </div>
  {{/if}}--}}
  
</section>
