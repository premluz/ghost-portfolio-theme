  <!-- GSAP + ScrollTrigger -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
  <script>
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);
      // Mobile address-bar show/hide during scroll fires a `resize` event,
      // which ScrollTrigger auto-refreshes on by default — recalculating
      // every scrub'd trigger's pixel start/end mid-scroll. For scrub
      // timelines already partway through (e.g. the homepage hero's exit
      // fade, scroll-scrub-anim.js initHero()), that mid-scroll refresh can
      // remap the current scroll position to a different progress value,
      // snapping the animation back toward its start — reads as content
      // "abruptly reappearing" while scrolling. This flag is GSAP's own
      // documented switch for exactly this case: viewport-height-only
      // changes from mobile browser chrome no longer trigger a refresh.
      ScrollTrigger.config({ ignoreMobileResize: true });
    }
  </script>

  <!-- Console cleanup: suppress verbose module logs. Installed this early
       (before three.js/preloader/intro/gradient-layer/etc. load) so no
       script gets a chance to log before the gate is active — moving this
       later (it used to sit near the end of <body>) left ~50 early
       top-level logs from those scripts ungated regardless of DEBUG_SCROLL. -->
  <script>
  (function() {
    // Persist DEBUG_SCROLL across full page navigations (localStorage, not
    // sessionStorage — should survive as long as the user wants it on, not
    // just one tab lifetime). Plain `window.DEBUG_SCROLL = true` is a
    // same-page-load-only flag otherwise — every step of a click-through
    // flow (home -> post -> close back to home) is a full navigation, so
    // debugging anything that spans one (e.g. the curtain-return/backfill
    // path) required re-typing the assignment in devtools after every
    // single page load. A getter/setter on `window.DEBUG_SCROLL` keeps the
    // exact same `window.DEBUG_SCROLL = true` UX while mirroring it to
    // localStorage under the hood, seeded from there on each fresh load.
    (function persistDebugScroll() {
      // Seeded from whichever is already true: a value some earlier script
      // (e.g. Playwright's addInitScript, or any other pre-paint script)
      // already assigned to window.DEBUG_SCROLL before this IIFE runs, OR
      // localStorage from a previous page. Checking localStorage alone
      // silently discarded an already-set `window.DEBUG_SCROLL = true` the
      // instant this ran, since Object.defineProperty replaces the plain
      // property outright — confirmed via Playwright tests going silent
      // after this persistence layer was added.
      let value = window.DEBUG_SCROLL === true;
      try { value = value || localStorage.getItem('DEBUG_SCROLL') === '1'; } catch (e) {}
      Object.defineProperty(window, 'DEBUG_SCROLL', {
        configurable: true,
        get() { return value; },
        set(v) {
          value = !!v;
          try {
            if (value) localStorage.setItem('DEBUG_SCROLL', '1');
            else localStorage.removeItem('DEBUG_SCROLL');
          } catch (e) {}
        },
      });
    })();

    const originalLog = console.log;
    const originalWarn = console.warn;
    const originalError = console.error;
    const suppressPatterns = [
      /\[gradient-layer\]/i,
      /\[gradient-animation-loop\]/i,
      /\[testimonial-modal\]/i,
      /\[post-and-cards\]/i,
      /\[ShapeLoader\] Failed to load GLB/i,
      /\[intro\]/i,
      /assets\/glb\//i,  // Suppress all GLB 404 errors
      /Missing elements/i
    ];

    const shouldSuppress = (msg) => {
      const text = msg?.toString?.() || '';
      return suppressPatterns.some(pattern => pattern.test(text));
    };

    // Silent by default — set window.DEBUG_SCROLL = true (devtools/URL) to
    // see the 300+ scroll/particle/morph logs this theme normally emits.
    // suppressPatterns above stays applied even in debug mode — those are
    // separately-known noise (GLB 404s, gradient-layer spam), not wanted
    // either way. console.error is never gated by the flag, only by
    // suppressPatterns, matching debug.js's debugError() "always log
    // errors, even in production" behavior.
    console.log = function(...args) {
      if (!window.DEBUG_SCROLL) return;
      if (shouldSuppress(args[0])) return;
      originalLog.apply(console, args);
    };

    console.warn = function(...args) {
      if (!window.DEBUG_SCROLL) return;
      if (shouldSuppress(args[0])) return;
      originalWarn.apply(console, args);
    };

    console.error = function(...args) {
      if (!shouldSuppress(args[0])) {
        originalError.apply(console, args);
      }
    };
  })();
  </script>

  <!-- Loaded this early so window.resizeManager exists before any later
       script that might subscribe to it during synchronous top-level
       execution (most subscribe from inside a constructor/init function
       called later, but this guarantees correctness regardless). -->
  <script src="{{asset "js/managers/ResizeManager.js"}}"></script>
  <script src="https://unpkg.com/three@0.160.0/build/three.min.js"></script>
  <script>
    // HERO PARTICLE OBJECT — the single switch, read by particle-morph.hbs,
    // scroll-scrub-anim.js and volatility-surface.js. Set it to any shape in
    // the VALID list in __heroShape() below; that one value is the whole
    // change, since the choreography in particle-morph.hbs is gated on it.
    // 'volatility' mounts the ground-plane lattice and no coil forms in the
    // hero; the coil shapes don't mount the lattice.
    window.HERO_PARTICLE_MODE = 'ribbon-dispersed';
    // Resolver was previously unable to return anything but
    // 'ribbon-dispersed': BOTH ternary arms were that literal, and the
    // condition tested `m === 'ribbon-dispersed'` twice (never comparing
    // against the other valid shapes), so HERO_PARTICLE_MODE was read and
    // then discarded. It said 'helix' while the hero actually rendered
    // ribbon-dispersed — the mode is now set to the shape that was really
    // being used, and the switch below genuinely honours it.
    window.__heroShape = () => {
      // Valid hero shapes, all registered (shape-definitions.js /
      // dispersed-variants.js):
      //   'ribbon-dispersed' = the scattered ribbon — the hero as shipped.
      //   'helix'            = original DNA-style double tube.
      //   'hero-helix'       = tilted, tapering halftone coil.
      //   'volatility'       = ground-plane lattice.
      const VALID = ['ribbon-dispersed', 'helix', 'hero-helix', 'volatility'];
      const m = window.HERO_PARTICLE_MODE;
      return VALID.includes(m) ? m : 'ribbon-dispersed';
    };

    // PARTICLE SCENARIOS — declarative section→behavior map. Every particle
    // scroll trigger routes through __particleApply(key, builtin, ms), so a
    // scenario overrides what any trigger does WITHOUT touching trigger code:
    //   ''       (or key absent) → the trigger's built-in shape
    //   'hide'                   → fade the whole particle layer out
    //   any shape name           → morph to that shape instead
    // Keys: hero, hero-exit, operating-model, operating-model-exit,
    //       helix-section, profile, profile-exit, stats, work-grid,
    //       work-cards, lab, testimonials, footer, footer-exit
    // Switch: edit PARTICLE_SCENARIO below, or at runtime:
    //   setParticleScenario('hero-footer')  (persists in localStorage, reloads)
    window.PARTICLE_SCENARIOS = {
      full: {
        'operating-model-exit': 'hide',
        testimonials: 'hide',
        'lab-exit': 'hide',
      },
      'hero-footer': {                // particles in hero, footer, Lab entrance + operating-model entrance
        'hero-exit': 'hide', // re-enabled after comparing visible-'dots'/'terrain' live — back to fading out on exit
        // 'operating-model' (the entrance key) intentionally absent — see
        // PARTICLE-SCROLL-DIRECTOR.md's zone table: un-hides for that
        // section's own sphere/triple-sphere/torus category-morph system.
        'operating-model-exit': 'hide',
        'helix-section': 'hide',
        profile: 'hide', 'profile-exit': 'hide',
        stats: 'hide',
        'work-grid': 'hide', 'work-cards': 'hide',
        //lab: 'hide',
        'lab-exit': 'hide',
        testimonials: 'hide',
        'footer-exit': 'hide',
        // hero + footer absent → their built-in shapes (volatility/helix, grid)
      },
    };
    window.PARTICLE_SCENARIO = localStorage.getItem('particle_scenario') || 'hero-footer';

    // 'dots' SHAPE — flat, non-rotating, sparse dot field (shape-definitions.js
    // DOTS/dotsGenerator). Fully built and registered (shape-definitions.js,
    // particle-morph-system.js, particle-animation-loop.js's rotation-freeze)
    // but not currently used by any trigger below or in particle-morph.hbs —
    // hero-exit/testimonials went back to their original targets ('terrain'/
    // 'dispersed', hidden via 'hide' above) after a round of trying 'dots' as
    // a visible/invisible resting shape didn't land right. To bring it back:
    // (1) test manually first — window.particleSystem.morphTo('dots', 0) in
    // the console; (2) change a trigger's builtinShape argument (in
    // particle-morph.hbs, both the gpu and legacy blocks) to 'dots'; (3) if
    // it should stay hidden rather than visible, also add that trigger's key
    // to PARTICLE_SCENARIOS above with 'hide'.

    // SCRUB KILL-SWITCH — diagnostic + low-end escape hatch. Scrub-driven
    // ScrollTriggers update on the main-thread rAF ticker; on weak GPUs the
    // compositor keeps scrolling smooth while JS rAF starves, so scrubbed
    // animations freeze mid-scroll and snap when scrolling stops. This
    // disables every scrub trigger WITH REVERT (inline styles removed →
    // content falls back to its visible CSS state), leaving the page fully
    // readable, just static. Toggle from the console:
    //   setScrubEnabled(false)  → static page (persists, reloads)
    //   setScrubEnabled(true)   → animations back
    // PERF HUD — diagnostic overlay for slow-machine investigation.
    // Console: showPerfHUD() -> live rAF fps / scroll events per second /
    // worst frame gap, top-right corner. showPerfHUD(false) removes it.
    window.showPerfHUD = (on = true) => {
      let el = document.getElementById('perf-hud');
      if (!on) { if (el) el.remove(); if (window.__hudStop) window.__hudStop(); return; }
      if (el) return;
      el = document.createElement('div');
      el.id = 'perf-hud';
      el.style.cssText = 'position:fixed;top:8px;right:8px;z-index:99999;background:rgba(0,0,0,.8);color:#0f0;font:12px/1.5 monospace;padding:8px 10px;border-radius:6px;pointer-events:none;white-space:pre';
      document.body.appendChild(el);
      let frames = 0, scrolls = 0, last = performance.now(), worst = 0, run = true;
      const tick = (now) => { frames++; worst = Math.max(worst, now - last); last = now; if (run) requestAnimationFrame(tick); };
      requestAnimationFrame(tick);
      const onScroll = () => scrolls++;
      window.addEventListener('scroll', onScroll, { passive: true });
      const iv = setInterval(() => {
        el.textContent = 'rAF fps: ' + (frames * 2) + String.fromCharCode(10) + 'scroll ev/s: ' + (scrolls * 2) + String.fromCharCode(10) + 'worst frame: ' + Math.round(worst) + 'ms';
        frames = 0; scrolls = 0; worst = 0;
      }, 500);
      window.__hudStop = () => { run = false; clearInterval(iv); window.removeEventListener('scroll', onScroll); };
    };

    // GLOBAL ANIMATION KILL-SWITCH — supersets the scrub switch below.
    // Console: setAnimationsEnabled(false) → fully static site (persists):
    //   scrub triggers off (revert to visible CSS states), GSAP time-based
    //   tweens complete instantly (entrances land revealed), CSS
    //   transitions/keyframes zeroed, particle layer hidden with its render
    //   loop never started. setAnimationsEnabled(true) restores everything.
    window.setAnimationsEnabled = (on) => {
      if (on) { localStorage.removeItem('animations_off'); localStorage.removeItem('scrub_off'); }
      else { localStorage.setItem('animations_off', '1'); localStorage.setItem('scrub_off', '1'); }
      location.reload();
    };
    if (localStorage.getItem('animations_off')) {
      document.documentElement.classList.add('no-anim');
      window.__particleLayerHidden = true; // render loop gate — never draws a frame
      // gsap loads later; as soon as it exists, make every time-based tween
      // effectively instant (scrub tweens are progress-driven and are
      // handled by the scrub_off path instead)
      const tick = setInterval(() => {
        if (window.gsap) { gsap.globalTimeline.timeScale(1000); clearInterval(tick); }
      }, 50);
      setTimeout(() => clearInterval(tick), 10000);
    }

    window.setScrubEnabled = (on) => {
      if (on) localStorage.removeItem('scrub_off');
      else localStorage.setItem('scrub_off', '1');
      location.reload();
    };
    if (localStorage.getItem('scrub_off')) {
      window.addEventListener('load', () => setTimeout(() => {
        if (!window.ScrollTrigger) return;
        let n = 0;
        ScrollTrigger.getAll().forEach((st) => {
          if (st.vars && st.vars.scrub) { st.disable(true); n++; }
        });
        console.log('[scrub] disabled ' + n + ' scrubbed ScrollTriggers — setScrubEnabled(true) to restore');
      }, 1200), { once: true });
    }
    window.setParticleScenario = (name) => { localStorage.setItem('particle_scenario', name); location.reload(); };

    // NO-HERO PAGES (hero-footer scenario): scenario 'hide' entries only
    // take effect when a trigger fires — a page without the homepage's
    // sections would keep whatever state the layer initialized with.
    // NOTE: /work/, /about/, /contact/ and posts are ALSO excluded from
    // the particle system upstream (particle-morph.hbs isPostPageOrExcluded
    // hides the container entirely), so today this rule is belt-and-braces;
    // it matters for any FUTURE hero-less page that isn't in that list,
    // keeping the particles-only-on-hero-and-footer intent true there.
    if (window.PARTICLE_SCENARIO === 'hero-footer') {
      document.addEventListener('DOMContentLoaded', function () {
        if (!document.querySelector('.hero')) {
          window.__particleLayerHidden = true;
          var layer = document.getElementById('particle-morph-demo');
          if (layer) layer.style.opacity = '0';
        }
      });
    }

    // CURTAIN-RETURN GUARD moved to a <head> script (before <body>/<main>
    // exist at all) — this ran too late to actually prevent the hero/
    // particle-layer first paint it was meant to guard against. window.
    // __particleLayerHidden and html.curtain-restoring are both already
    // set by the time this script runs, if this load is a curtain return.

    window.__particleApply = function (system, key, builtinShape, duration, fadeMsOverride) {
      // Global animation kill-switch is authoritative: no morphs, and never
      // clear the hidden flag (a show-path call here used to re-arm the
      // render loop even though the container was display:none).
      if (document.documentElement.classList.contains('no-anim')) return;
      // HERO GUARDS. (1) While the curtain-return veil is up, 'hero'
      // applications are ignored outright — the entrance morph fires at
      // scrollY 0 BEFORE the restore sweep starts, and letting it through
      // would show the layer only for the sweep to hide it again mid-fade
      // (the reported flash). Only sweep-driven triggers (hero-exit,
      // footer, …) may take ownership and drop the veil. (2) Independent
      // of the veil: a 'hero' apply landing well past the hero itself is
      // stale — never re-show mid-page. Threshold scales with the hero's
      // own height rather than a fixed px value: the 'hero' director zone
      // (particle-morph.hbs) and particle-animation-loop.js's
      // _checkHeroReentry() both call 'hero' continuously as you scroll
      // back up through the whole hero (up to ~65% of its height — the
      // collapse span plus its return-glide span), not just in the first
      // few px like the ScrollTrigger this whole mechanism originally
      // replaced, so a fixed ~150px cutoff would silently drop most of
      // those legitimate calls.
      const veiled = document.documentElement.classList.contains('curtain-restoring');
      if (key === 'hero') {
        const heroEl = document.querySelector('.hero');
        const heroHeight = heroEl ? heroEl.getBoundingClientRect().height : 800;
        if (veiled || window.scrollY > heroHeight) return;
      }
      document.documentElement.classList.remove('curtain-restoring');
      const scen = window.PARTICLE_SCENARIOS[window.PARTICLE_SCENARIO] || {};
      const target = (scen[key] === undefined || scen[key] === '') ? builtinShape : scen[key];
      const layer = document.getElementById('particle-morph-demo');
      if (target === 'hide') {
        // Play the trigger's built-in morph (usually 'dispersed') UNDER the
        // fade, so hiding reads as "particles disperse away" rather than a
        // frozen shape dimming out — but only if the layer is currently
        // visible (morphing an already-hidden layer is wasted work).
        //
        // Gate on __particleHiding, NOT __particleLayerHidden: the latter
        // only flips true via the setTimeout below, once a fade has fully
        // finished, so it stays false for the whole fadeMs/hideDelayMs
        // window while a fade is already in flight. A second 'hide' caller
        // landing in that window (e.g. work-cards' trigger firing while
        // hero-exit's own ~2.1s fade is still running) used to see
        // __particleLayerHidden still false and re-morph the still-visible,
        // still-fading layer to ITS builtin shape ('collapse') — a visible
        // sphere flash mid-fade. __particleHiding goes true synchronously
        // the instant any hide is requested, so a later hide request during
        // the same in-flight fade just re-arms the fade/timer, never the
        // shape morph.
        const alreadyHiding = window.__particleHiding;
        window.__particleHiding = true;
        if (!alreadyHiding && system && typeof system.morphTo === 'function' && builtinShape) {
          system.morphTo(builtinShape, duration);
        }
        // Fade/hide timing scales WITH duration (1.5x / 1.75x) by default —
        // every existing caller still passes 400ms, so this reproduces
        // today's exact constants everywhere unchanged (400*1.5=600,
        // 400*1.75=700). fadeMsOverride decouples the fade from the SHAPE
        // morph's own duration for callers that want the shape-swap fast
        // (matching every other 'hide' trigger) but the fade itself
        // slower — hero-exit's own "keep rotating while it dissolves"
        // request specifically (particle-animation-loop.js): the shape
        // settles at the normal 400ms pace, then lingers, still spinning,
        // through a longer fade instead of everything ending together.
        // hideDelayMs keeps the SAME ratio to whichever fade is in play
        // (1.75/1.5 ≈ 1.1667x it), so the render loop still only pauses
        // shortly AFTER the fade is visually done, never mid-fade.
        const fadeMs = fadeMsOverride != null ? fadeMsOverride : duration * 1.5;
        const hideDelayMs = fadeMs * (1.75 / 1.5);
        if (layer) { layer.style.transition = `opacity ${fadeMs / 1000}s ease`; layer.style.opacity = '0'; }
        // Pause the render loop only AFTER the fade finishes — pausing
        // immediately would freeze the first hidden frame and the disperse
        // morph above would never be seen.
        clearTimeout(window.__particleHideTimer);
        window.__particleHideTimer = setTimeout(() => { window.__particleLayerHidden = true; }, hideDelayMs);
        return;
      }
      clearTimeout(window.__particleHideTimer);
      window.__particleLayerHidden = false;
      window.__particleHiding = false;
      if (layer && layer.style.opacity === '0') { layer.style.transition = 'opacity 0.6s ease'; layer.style.opacity = '1'; }
      if (system && typeof system.morphTo === 'function' && target) system.morphTo(target, duration);
    };
  </script>
