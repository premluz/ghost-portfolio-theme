  {{!-- .invert-wrapper (main.css) auto-init for scroll-scrubbed mode — see
        INVERSION.md. Forced (always-on) is the class's own CSS default
        (--profile-shift: 1); adding data-invert-scroll to an instance
        replaces that with a live scroll-driven value instead — an inline
        style from bindShift's root.style.setProperty always outranks the
        class rule for the same property, so no modifier class is needed to
        switch modes. Same "no per-page JS" auto-init convention as
        gradient-frame.js's [data-gradient-frame]. --}}
  <script>
    (function () {
      if (!window.BackgroundLayer) return;
      document.querySelectorAll('.invert-wrapper[data-invert-scroll]').forEach(function (el) {
        window.BackgroundLayer.bindShift(el, '--profile-shift', { root: el, quantize: 0.05 });
      });
    })();
  </script>

  {{!-- PER-INSTANCE COLOUR OVERRIDES for the BOXED variants (base
        .invert-wrapper and .invert-wrapper--full) — two independent
        attributes, either usable alone:

          data-shift-bg="#123456"    the colour this block's background shifts TO
          data-shift-ink="#ffffff"   the colour its text/icons shift TO

        -bg alone = pure background change, text keeps the theme's own shift
        ink (right when the custom colour sits near the default shift target
        in lightness). -ink alone = re-point text only. Both = full control,
        the only combination that is contrast-correct by construction.

        Set ON THE ELEMENT here, unlike the --page variant further down which
        must reach :root: these variants consume the properties from their
        own cascade (::before paints var(--shift-bg); the color-mix() ink
        rules in main.css read var(--shift-ink) off the same element).

        Runs for EVERY matching instance, not just [data-invert-scroll] ones
        above — the base class is always-on by default (--profile-shift: 1),
        so most instances never carry that attribute and would otherwise be
        skipped. Excludes --page, which is handled by its own init below with
        a different target.

        JS rather than a CSS attr() rule on purpose: attr() with a type is
        CSS Values 5, Chrome-only as of 2026-08, and fails silently (the
        declaration is invalid at computed-value time, so the property keeps
        its inherited value) in Safari and Firefox. See the matching note in
        main.css next to .invert-wrapper. --}}
  <script>
    (function () {
      document.querySelectorAll('.invert-wrapper:not(.invert-wrapper--page)').forEach(function (el) {
        var bg = el.getAttribute('data-shift-bg');
        var ink = el.getAttribute('data-shift-ink');
        if (bg) el.style.setProperty('--shift-bg', bg);
        // "invert" is a keyword, not a colour — writing it literally would
        // make --shift-ink an invalid colour and every color-mix() reading
        // it would drop out. Nothing to write: the CSS neutralisation rule
        // (.invert-wrapper[data-shift-bg]:not([data-shift-ink])) already
        // fails to match once the attribute is present, so the inherited
        // theme --shift-ink survives, which IS the inverted ink.
        if (ink && ink !== 'invert') el.style.setProperty('--shift-ink', ink);
      });
    })();
  </script>

  {{!-- .invert-wrapper--page (main.css) — PAGE-LEVEL variant: instead of
        .invert-wrapper's own local ::before panel (scoped to just this
        element, background color-mix()'d only inside it), this writes to
        the SAME --gradient-shift-3 slot + :root default binding
        (document.documentElement) that testimonials-section already uses
        on the homepage (scroll-scrub-anim.js's initTestimonialsColorInvert)
        — #page-backdrop (main.css) reads --profile-shift = max() of the
        four --gradient-shift-N slots and blends the WHOLE fixed viewport
        background, not just this element's own box, exactly matching
        "affect the page bg, not the container bg" for testimonials-style
        sections pasted into a post. Slot 3 (not 0): gradient-frame.js
        auto-indexes invert-mode .gradient-frame instances starting at 0
        (e.g. .post-hero-gradient-frame on post pages, if present) — using
        the last slot keeps this out of that auto-increment's way, same
        reasoning testimonials' own binding already documents.
        Scroll-scrubbed BY DEFAULT (the inverse of .invert-wrapper, which is
        forced by default and opts INTO scrubbing via data-invert-scroll):
        a page-level shift repaints the fixed backdrop, so a static one holds
        its colour for the rest of the page's scroll range with no way back.
        Opt out per instance with data-invert-static — see its own note
        below for when that is the right call. --}}
  {{!-- PER-INSTANCE COLOUR OVERRIDES (2026-08-20) — two independent
        attributes on the same .invert-wrapper--page element:

          data-shift-bg="#123456"    the colour the page background shifts TO
          data-shift-ink="#ffffff"   the colour text/icons shift TO

        Either may be set alone. Set only -bg for a pure background change
        (text keeps whatever the theme's own --shift-ink gives it — correct
        when the custom colour is close in lightness to the default shift
        target); set only -ink to re-point text without touching the
        background; set both for full control, which is the only combination
        that is always contrast-correct by construction.

        MUST be promoted to :root, not left on the element. Unlike the base
        .invert-wrapper (which paints its own ::before from --shift-bg and so
        reads the property from itself), the --page variant paints nothing:
        it drives #page-backdrop, a FIXED full-viewport element outside this
        wrapper's subtree, plus the site-wide color-mix() text rules in
        main.css that read --shift-ink from :root. Neither can see a custom
        property set on the wrapper, so setting it there would silently do
        nothing.
        Written on documentElement — the same element bindShift already
        writes --gradient-shift-3 to, so the value and the scroll progress
        that drives it live in one place.

        Scoped by the shift itself, not by time: --shift-bg/--shift-ink are
        only ever CONSUMED through a color-mix() weighted by --profile-shift,
        which is 0 whenever no shift zone is active. An override sitting on
        :root outside its own zone therefore has no visual effect — no
        teardown needed. With several --page wrappers on one page the last
        one initialised wins the :root value; they share a single
        --gradient-shift-3 slot already, so overlapping zones were never
        independently addressable. --}}
  {{!-- data-invert-static — opt OUT of scroll-scrubbing for a --page
        instance. Default stays scrub (see the caveat in the doc above: a
        static page-level shift repaints the FIXED backdrop and, having no
        exit ramp, holds that colour for the whole rest of the page's scroll
        range). That is genuinely what you want when the shifted block is the
        last thing on the page, or when the surrounding sections carry their
        own opaque backgrounds — hence an explicit opt-in rather than a
        blanket behaviour change.
        Implemented by pinning the slot to 1 and NOT binding: --profile-shift
        is max() of the four --gradient-shift-N slots, so a constant 1 in
        slot 3 reads as "fully shifted" everywhere, with nothing to scrub it
        back down.
        Also the escape hatch for prefers-reduced-motion, which returns early
        below and otherwise leaves a --page instance with no shift at all: a
        static instance carries no motion, so it is applied before that
        guard and works regardless. --}}
  {{!-- MODE SELECTION — data-invert-mode="scrub" | "timed" | "static"

        One attribute with three values, because the three modes are mutually
        exclusive. They were originally three independent boolean attributes
        (data-invert-static / data-invert-timed / neither-for-scrub), which
        let a single element carry contradictory ones — hence the defensive
        :not() chains and the "timed wins" tiebreak still visible below.
        A single valued attribute makes them exclusive by construction.

          scrub   progress follows scroll position through the block
                  (BackgroundLayer.bindShift) — the original default
          timed   fades in on entry, out on leave, symmetric, re-triggers
          static  pinned on, no animation, no observer

        BACK-COMPAT: the old boolean attributes still work exactly as before.
        Each selector below matches either the new mode value OR the legacy
        attribute when no data-invert-mode is present, so nothing needed
        changing at the call sites. Omitting both still means scrub. Prefer
        data-invert-mode for anything new. --}}
  {{!-- data-shift-bg-light (2026-08-31) — THEME-RESPONSIVE colour, opts a
        --page instance OUT of scroll/time-based inversion entirely.

          data-shift-bg="#071E1B"         colour served in DARK theme
          data-shift-bg-light="#F2EFE9"   colour served in LIGHT theme

        data-shift-bg alone (no -light sibling) keeps its existing meaning
        on every branch below: a single fixed colour the section shifts TO,
        regardless of theme, via whatever scrub/timed/static animation the
        element's other attributes select. Adding -light changes the
        QUESTION being answered from "what colour does this scroll/time
        transition reveal" to "what colour does this theme serve" — there
        is no transition to speak of, so it is handled here, once, ahead of
        every mode branch, and excluded from all of them (the :not() below)
        rather than teaching each branch a theme-aware variant of its own
        animation.
        Static, not live-updating on an in-page theme toggle: matches every
        other --shift-bg/--shift-ink write on this page, none of which
        re-run on 'themechange' either — a toggle mid-scroll already
        requires a fresh look at the section to see any of these colours
        change, same as page background/particle colour elsewhere. --}}
  <script>
    (function () {
      var isLightTheme = document.documentElement.getAttribute('data-theme') === 'light';
      document.querySelectorAll('.invert-wrapper--page[data-shift-bg-light]').forEach(function (el) {
        var darkBg = el.getAttribute('data-shift-bg');
        var lightBg = el.getAttribute('data-shift-bg-light');
        var bg = isLightTheme ? lightBg : darkBg;
        var ink = el.getAttribute('data-shift-ink');
        var root = document.documentElement;
        if (bg) root.style.setProperty('--shift-bg', bg);
        else root.style.setProperty('--shift-bg', 'var(--shift-bg-theme)');
        // Same three-way ink resolution as the static/timed/scrub branches
        // below (see the timed branch's own long comment on the "invert"
        // keyword and the neutralise-vs-flip distinction) — a theme-
        // responsive background still needs the same contrast handling.
        if (ink === 'invert') root.style.removeProperty('--shift-ink');
        else if (ink) root.style.setProperty('--shift-ink', ink);
        else if (bg) root.style.setProperty('--shift-ink', 'var(--gradient-frame-ink-base)');
        else root.style.removeProperty('--shift-ink');
        root.style.setProperty('--gradient-shift-3', '1');
      });
    })();
  </script>

  <script>
    (function () {
      // Static instances first — deliberately ABOVE both guards below, since
      // neither applies to them: there is no motion to reduce, and pinning a
      // custom property needs no BackgroundLayer.
      // :not([data-invert-timed]) so an element carrying both attributes
      // resolves predictably (timed wins) instead of being pinned to 1 here
      // and then having nothing left for the fade to animate.
      // :not([data-shift-bg-light]) — theme-responsive instances are fully
      // handled by their own script block above; matching them again here
      // would immediately overwrite that resolved colour with the plain
      // data-shift-bg (dark-only) reading.
      document.querySelectorAll(
        '.invert-wrapper--page[data-invert-mode="static"]:not([data-shift-bg-light]),' +
        '.invert-wrapper--page[data-invert-static]:not([data-invert-timed]):not([data-invert-mode]):not([data-shift-bg-light])'
      ).forEach(function (el) {
        var sBg = el.getAttribute('data-shift-bg');
        var sInk = el.getAttribute('data-shift-ink');
        if (sBg) document.documentElement.style.setProperty('--shift-bg', sBg);
        else document.documentElement.style.setProperty('--shift-bg', 'var(--shift-bg-theme)');
        // Three-way, matching the timed and scrub branches — see the scrub
        // branch's comment for why the no-attributes case must CLEAR rather
        // than skip (shared :root property, previous wrapper's value leaks).
        // "invert" keyword — see the timed branch below.
        if (sInk === 'invert') document.documentElement.style.removeProperty('--shift-ink');
        else if (sInk) document.documentElement.style.setProperty('--shift-ink', sInk);
        else if (sBg) document.documentElement.style.setProperty('--shift-ink', 'var(--gradient-frame-ink-base)');
        else document.documentElement.style.removeProperty('--shift-ink');
        document.documentElement.style.setProperty('--gradient-shift-3', '1');
      });

      // TIMED instances — fade the page colour in on a timer when the block
      // first reaches the viewport, then hold. Also above the guards: the
      // reduced-motion case still wants the colour (the shift carries the
      // section's palette, not decoration), just without the animation, and
      // main.css drops the transition under that media query while leaving
      // the value change intact. Needs no BackgroundLayer either — the whole
      // animation is the registered-@property transition in CSS; this only
      // decides WHEN to flip the class.
      // :not([data-shift-bg-light]) — theme-responsive instances are fully
      // handled by their own script block above (static colour, no
      // observer); excluded here so the enter/leave IntersectionObserver
      // below never overwrites that resolved colour mid-scroll.
      var timed = document.querySelectorAll(
        '.invert-wrapper--page[data-invert-mode="timed"]:not([data-shift-bg-light]),' +
        '.invert-wrapper--page[data-invert-timed]:not([data-invert-mode]):not([data-shift-bg-light])'
      );
      if (timed.length) {
        // Colours are applied at TRIGGER time (inside the observer below),
        // not up-front here. --shift-bg/--shift-ink are single :root
        // properties shared by every --page instance, so writing them during
        // init means the LAST wrapper on the page wins regardless of which
        // one the viewer is actually looking at. Measured live on a post page
        // carrying two --page wrappers (#000000 scrubbed, #161616 timed): the
        // scrubbed one initialised second and left --shift-bg at #000000, so
        // the timed block faded to the wrong colour.
        // Applying on entry makes the colour follow whichever block was
        // actually reached, which is the only correct rule while the
        // properties remain page-global.
        // SYMMETRIC: fades in on enter, back out on leave, and re-triggers
        // every time. The observer therefore stays connected (an earlier
        // version disconnected after the first entry, which is why the colour
        // held for the rest of the page).
        //
        // The slot is written INLINE both ways rather than left to the
        // html.invert-timed-active rule in main.css. That rule cannot win:
        // other bindShift consumers (scroll-scrub-anim.js's testimonials
        // binding, present on post pages too) write --gradient-shift-3 as an
        // INLINE style on this same documentElement every scroll frame, and
        // an inline declaration always outranks a stylesheet one. Measured
        // live: the class was correctly added but the slot still read 0,
        // because testimonials — scrolled far out of its own range — kept
        // re-writing 0 inline over it.
        //
        // Leaving sets the slot back to 0 rather than removing the property:
        // removing it would fall back to whatever the stylesheet says, which
        // for an active .invert-timed-active class is 1 — i.e. it would not
        // revert at all. An explicit inline 0 is the only value that both
        // reverts and keeps outranking the other inline writers. The
        // transition (main.css, on :root) animates the 1->0 exactly as it
        // does 0->1, so the fade is symmetric for free.
        //
        // TRIGGER ZONE — rootMargin pulls both viewport edges inward by 25%,
        // leaving the middle 50% of the screen as the active band.
        //
        // rootMargin, not a bigger threshold, because the two are not
        // interchangeable here: a single threshold value fires at the SAME
        // visibility fraction in both directions, so it can only widen or
        // narrow the zone symmetrically — it cannot delay the entry AND
        // advance the exit. Shrinking the root box does exactly that: the
        // block must travel 25% of the viewport further in before it counts
        // as intersecting, and stops counting 25% sooner on the way out.
        // Net effect is the requested "start later, leave earlier" — an
        // active window ~50% narrower than the previous full-viewport root.
        // Percentages (not px) so it scales with viewport height rather than
        // reading very differently on a phone vs a desktop.
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            var root = document.documentElement;
            if (entry.isIntersecting) {
              var tBg = entry.target.getAttribute('data-shift-bg');
              var tInk = entry.target.getAttribute('data-shift-ink');
              if (tBg) root.style.setProperty('--shift-bg', tBg);
              else root.style.setProperty('--shift-bg', 'var(--shift-bg-theme)');
              // No data-shift-ink -> neutralise the ink shift instead of
              // leaving :root's theme value in place. --shift-ink is always
              // defined per theme (tokens.css) as the OPPOSITE palette's
              // ink, and ~20 site-wide rules in main.css mix toward it
              // whenever --profile-shift is non-zero — so "-bg only" was
              // still re-pointing every heading, paragraph, link and icon.
              // Pointing it at --gradient-frame-ink-base (the theme's real
              // ink, captured at :root by gradient-frame.css) makes each of
              // those color-mix()es an identity: the background shifts, the
              // text stays exactly as the active theme has it.
              // Mirrors the CSS rule for non---page wrappers
              // (.invert-wrapper:not([data-shift-ink]), main.css); this
              // branch is needed because --page promotes the property to
              // :root, out of that selector's reach.
              // Gated on tBg: neutralise ink only for a FIXED-background
              // wrapper. With neither attribute set this is a plain
              // "invert this section" request, where bg and ink must flip
              // together — neutralising there would put theme ink on an
              // opposite-palette background. Mirrors the CSS selector
              // .invert-wrapper[data-shift-bg]:not([data-shift-ink]).
              // data-shift-ink="invert" — a KEYWORD, not a colour: keep the
              // theme's own inverted ink (the value :root already holds)
              // while data-shift-bg pins a fixed background. Without it a
              // fixed-bg wrapper always neutralises ink (see below), which
              // is right for a light-ish fixed colour but wrong for a very
              // dark one like #071E1B, where the text must flip to stay
              // readable. removeProperty (not a value) is what restores the
              // theme's own --shift-ink from tokens.css.
              if (tInk === 'invert') root.style.removeProperty('--shift-ink');
              else if (tInk) root.style.setProperty('--shift-ink', tInk);
              else if (tBg) root.style.setProperty('--shift-ink', 'var(--gradient-frame-ink-base)');
              else root.style.removeProperty('--shift-ink');
              root.classList.add('invert-timed-active');
              root.style.setProperty('--gradient-shift-3', '1');
            } else {
              root.classList.remove('invert-timed-active');
              root.style.setProperty('--gradient-shift-3', '0');
            }
          });
        // threshold 0 with the shrunk root, NOT 0.15. intersectionRatio is
        // measured against the ELEMENT's own area, so a block taller than the
        // shrunk root can never reach a 15% ratio no matter where it sits:
        // at 25%/25% the root is half the viewport, so anything taller than
        // ~3.3 viewports caps out below 0.15 and would NEVER fire. This
        // block already carries 40vh+55vh of wash padding, so that is a live
        // risk, not a hypothetical.
        // With the root already shrunk to the middle band, threshold 0 means
        // "any part of the block has reached that band" — which is the
        // intended trigger anyway, and is height-independent by construction.
        }, { threshold: 0, rootMargin: '-60% 0px -60% 0px' });
        timed.forEach(function (el) { io.observe(el); });
      }

      if (!window.BackgroundLayer) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      // :not([data-shift-bg-light]) — same exclusion as the static/timed
      // branches above: theme-responsive instances need no scrub binding.
      document.querySelectorAll(
        '.invert-wrapper--page[data-invert-mode="scrub"]:not([data-shift-bg-light]),' +
        '.invert-wrapper--page:not([data-invert-mode]):not([data-invert-static]):not([data-invert-timed]):not([data-shift-bg-light])'
      ).forEach(function (el) {
        var bg = el.getAttribute('data-shift-bg');
        var ink = el.getAttribute('data-shift-ink');
        // Colours applied ON PROGRESS, not at init — same rule the timed
        // branch above already follows, and for the same reason.
        //
        // --shift-bg/--shift-ink are single :root properties shared by every
        // --page instance. Writing them here at init meant the LAST scrub
        // wrapper on the page won globally and permanently, so with two
        // wrappers on one page the earlier one's colours never applied:
        // reported as "the first one not working, the second does".
        //
        // Writing them only while this block's own shift is actually
        // ramping (t > 0) makes the colours follow whichever block the
        // viewer has reached, which is the only correct rule while the
        // properties remain page-global. At t === 0 this block has nothing
        // to say, so it stays silent and leaves the slot to whoever does.
        window.BackgroundLayer.bindShift(el, '--gradient-shift-3', {
          quantize: 0.05,
          onProgress: function (t) {
            if (t <= 0) return;
            var root = document.documentElement;
            // Cleared when absent, not just skipped — same shared-:root
            // leak as --shift-ink below. The bare wrapper on the homepage
            // was inheriting the PREVIOUS wrapper's fixed #210C27 instead
            // of falling back to the theme's own inverted background.
            if (bg) root.style.setProperty('--shift-bg', bg);
            else root.style.setProperty('--shift-bg', 'var(--shift-bg-theme)');
            // Three-way, same as the timed branch above — and it must CLEAR
            // the property in the no-attributes case, not just skip it.
            // --shift-ink is a single :root property shared by every --page
            // wrapper, so `if (ink)` alone left whatever the previous
            // wrapper wrote still in place. A fixed-background wrapper
            // earlier on the page neutralises --shift-ink to the theme's own
            // ink (see below); that value then persisted into this bare
            // "invert the section" wrapper and silently suppressed its
            // inversion — the reported "theme not reverting" on the
            // homepage, where exactly that pair sits one after the other.
            // "invert" keyword — see the timed branch above.
            if (ink === 'invert') root.style.removeProperty('--shift-ink');
            else if (ink) root.style.setProperty('--shift-ink', ink);
            else if (bg) root.style.setProperty('--shift-ink', 'var(--gradient-frame-ink-base)');
            else root.style.removeProperty('--shift-ink');
          },
        });
      });
    })();
  </script>
