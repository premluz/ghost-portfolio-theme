  <style>
    /*
     * Accent color injection from Ghost admin settings.
     * Only --color-primary is set here. All other semantic tokens
     * (--color-link, --color-link-hover, --color-secondary) are
     * derived from --color-primary inside tokens.css to keep one
     * source of truth and avoid cascade conflicts.
     */
    :root {
      /* Ghost accent color injection — commented out; tokens.css uses near-white instead
      {{#if @site.accent_color}}
        --color-primary: {{@site.accent_color}};
      {{/if}}
      */

      /* NAV ACTIVE COLOUR — the Ghost Admin accent (Design → Brand colour),
         injected as its OWN token rather than by re-enabling the
         --color-primary block above.

         Why not just uncomment that: --color-primary is consumed site-wide
         (links, buttons, headings, .nav-menu a:hover, the profile-shift
         color-mix chains) and is deliberately pinned to near-white/near-black
         today — see the "revert: restore accent colour" notes in tokens.css.
         Turning it back on would recolour all of those at once, which is a
         much larger change than "make the selected nav icon the theme
         colour". This token carries the accent to exactly the place that
         asked for it and nowhere else.

         Falls back to the brand green primitive when no accent is set in
         Ghost, so the rule always has a real colour to work with. */
      {{#if @site.accent_color}}
        --nav-active-color: {{@site.accent_color}};
      {{else}}
        --nav-active-color: oklch(50% 0.2 142);
      {{/if}}
      {{#if @site.icon}}
        --publication-icon: url('{{@site.icon}}');
      {{/if}}
      --color-particles: #1D4551; /* darkened further (~30%) from #296274 — still reading too bright */
      /* Lab section's scroll-driven wave tint (uWaveColor, particle-
         animation-loop.js) — read by particle-morph.hbs's applyTheme() on
         theme change. Orchid is the ORIGINAL hardcoded value (was the same
         hex for both themes before this token existed); change per-theme
         here instead of touching the JS default. See COLOR-TUNING.md. */
      --color-particles-wave: #da70d6; /* Orchid — original hardcoded value */
    }

    :root[data-theme='light'] {
      /* Ghost accent color injection — commented out; tokens.css uses near-black instead
      {{#if @site.accent_color}}
        --color-primary: {{@site.accent_color}};
      {{else}}
        --color-primary: #60A26B;
      {{/if}}
      */
      /* Briefly changed to a light grey (#9CA3AF) on 2026-08-31 to soften
         the bloom, then reverted the SAME DAY — the actual particle DOTS
         need to stay dark to read against the light backdrop (light dots
         on a light background is close to invisible); only the glow/halo
         AROUND them was too heavy. Core and halo share this one colour in
         the shader (particle-style-definitions.js's default style has no
         separate halo-colour uniform), so the halo's weight is tuned via
         particle-morph.hbs's HALO_MULT_LIGHT_MULT instead of a colour
         change here.
         Light mode reads on a ~L*98 backdrop, so contrast comes from how far
         BELOW the page the particle sits — the darker this is, the more each
         unit of sprite alpha buys. Measured against dark mode as the target
         (dark: mean deltaL of the hottest 1% = 22.4, share of pixels past a
         2-deltaL JND = 2.28%): #17516E left light mode at 15.9 / 0.80% —
         "barely visible". #082A3C plus the light glow-radius bump in
         particle-morph.hbs lands 24.2 / 2.29%. Colour alone cannot close it
         (see GLOW_RADIUS_LIGHT_MULT there) — the two are one tuning pair.
         KEEP IN SYNC with PARTICLE_NORMAL.light AND PARTICLE_SHIFTED.dark in
         scroll-scrub-anim.js, which both mirror this literal. */
      --color-particles: #082A3C; /* was #17516E, itself darkened from #2787B7 */
      /* Lab wave tint, light mode — see the dark-mode token's own comment
         above for what this drives. Same Orchid as dark mode by default
         (no change in behaviour); tune independently here. */
      --color-particles-wave: #da70d6; /* Orchid — original hardcoded value */
    }

    :root[data-theme='dim'] {
      /* Ghost accent color injection — commented out; tokens.css uses near-white instead
      {{#if @site.accent_color}}
        --color-primary: {{@site.accent_color}};
      {{/if}}
      */
    }
