  <script>
    // Pre-paint continuity for the page-to-page loading bar: page-
    // transition.js's armLoadingBar() sets sessionStorage 'ptBarStart' on
    // the OUTGOING page right before the real browser navigation
    // (window.location.href) tears down that JS context. Without this,
    // the chase would only start once the INCOMING page's own scripts run
    // (near the end of <body>) — visibly flashing off during the actual
    // network gap and back on a beat later. Placed inline, immediately
    // after .scroll-progress's own markup (not in <head>, where main-
    // pending/landing-pending live) because it needs the element to
    // already be parsed — synchronous <script> execution during HTML
    // parsing means this still runs well before first paint in practice.
    // Read (and cleared) again by page-transition.js's releaseLoadingBar()
    // at the same point main-pending/landing-pending are removed; kept
    // here too (not cleared) so a direct/external load — no transition in
    // flight — simply finds nothing and does nothing.
    (function () {
      try {
        if (!sessionStorage.getItem('ptBarStart')) return;
        var bar = document.getElementById('scroll-progress');
        if (bar) bar.classList.add('is-loading');
      } catch (e) {}
    })();
