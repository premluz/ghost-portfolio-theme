  {{!-- Must be the first script in <head>: an import map only applies to
        module resolution requests (including dynamic import()) made AFTER
        it's parsed. This used to sit much later in <body> (~line 447) and
        broke any body-content script whose dynamic import() fired at parse
        time, before the browser reached that point — e.g.
        gradflow-background.js's import('ogl'), called synchronously from
        posts-tabs-grid-lab.hbs, well above where this tag used to live. --}}
  <script type="importmap">
    {
      "imports": {
        "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
        "three/": "https://unpkg.com/three@0.160.0/",
        "ogl": "https://unpkg.com/ogl@1.0.11/src/index.js"
