<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="color-scheme" content="dark light">
  <meta name="theme-color" content="#1d1e1f">
  <meta name="robots" content="noindex, nofollow">
  {{!-- Must be the first script in <head>: an import map only applies to
        module resolution requests (including dynamic import()) made AFTER
        it's parsed. This used to sit much later in <body> (~line 447) and
        broke any body-content script whose dynamic import() fired at parse
        time, before the browser reached that point — e.g.
        gradflow-background.js's import('ogl'), called synchronously from
        posts-tabs-grid-lab.hbs, well above where this tag used to live. --}}
  <script type="importmap">
    {
      "imports": {
        "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
        "three/": "https://unpkg.com/three@0.160.0/",
        "ogl": "https://unpkg.com/ogl@1.0.11/src/index.js"
      }
    }
  </script>
  <script>
    // Apply saved theme and set root background immediately to prevent white flash
    // Runs before any CSS or external resource can trigger a paint.
    // ⚠ REGRESSION MAGNET: an old copy of this block was pasted back once
    // (stale hexes + body background rules) and broke the profile palette
    // shift in light mode. If you edit this block, keep three invariants:
    //   1. Hexes here are manual copies of tokens.css's --theme-light-bg /
    //      --theme-dark-bg — update together (see COMMON_ISSUES.md).
    //   2. NEVER set a body background (inline or in the <style> below):
    //      body must stay transparent so the fixed #page-backdrop can paint
    //      the shiftable page background (CSS paint order puts it below
    //      in-flow block backgrounds — an opaque body hides it silently).
    //   3. window.__THEME_BG_COLORS__ is read by theme.js — keep exporting it.
    (function() {
      // Single source of truth for the anti-flash hex values — exposed on
      // window so theme.js's setTheme() reads these instead of keeping its
      // own copy (they'd previously drift independently). The <style>
      // fallback below can't reference this (CSS, no JS) and stays a
      // necessarily-separate hardcoded copy — keep it in sync manually.
      var THEME_BG = { light: '#FAFAF8', dim: '#1d1e1f', dark: '#1d1e1f' };
      window.__THEME_BG_COLORS__ = THEME_BG;

      var saved = localStorage.getItem('theme-preference');
      var defaultTheme = '{{@custom.color_scheme}}';
      var theme = saved !== null ? saved : defaultTheme;

      if (theme === 'auto' || theme === 'dim') {
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        theme = prefersDark ? 'dark' : 'light';
      }

      var bg = THEME_BG[theme] || THEME_BG.dark;
      var colorScheme = (theme === 'light') ? 'light' : 'dark';

      // Set inline style on html immediately (before CSS loads) to prevent
      // white flash. html ONLY — see invariant 2 above re: body.
      document.documentElement.style.backgroundColor = bg;
      document.documentElement.style.colorScheme = colorScheme;

      // Also set data-theme for CSS selectors
      if (theme === 'light') {
        document.documentElement.setAttribute('data-theme', 'light');
      } else if (theme === 'dim') {
        document.documentElement.setAttribute('data-theme', 'dim');
      } else {
        document.documentElement.removeAttribute('data-theme');
      }

      // Keep theme-color and color-scheme meta tags in sync (browser paints before CSS)
      var metaTheme = document.querySelector('meta[name="theme-color"]');
      if (metaTheme) metaTheme.setAttribute('content', bg);
      var metaScheme = document.querySelector('meta[name="color-scheme"]');
      if (metaScheme) metaScheme.setAttribute('content', colorScheme);

      // TEMPORARY DIAGNOSTIC (2026-08-19, v2) — REMOVE once the curtain-
      // return white-flash bug is understood. ?flashdiag=1 only.
      // v1 tracked --profile-shift/--gradient-shift-N and disproved that
      // theory (every snapshot read 0 across a real repro) — see the
      // console.table output already collected. v2 instead reads the
      // ACTUAL rendered background-color of every candidate paint layer
      // directly via getComputedStyle, since that's ground truth regardless
      // of which custom property (if any) is actually responsible.
      // #page-backdrop may not exist yet at the earliest checkpoints (it's
      // in <body>, this runs in <head>) — guarded per-call.
      if (/[?&]flashdiag=1/.test(location.search)) {
        window.__flashdiag = window.__flashdiag || [];
        window.__flashdiagSnap = function (point) {
          var htmlEl = document.documentElement;
          var bodyEl = document.body;
          var backdropEl = document.getElementById('page-backdrop');
          var scrimEl = document.getElementById('pt-scrim');
          var gradflowEl = document.querySelector('.gradflow-page-bg');
          window.__flashdiag.push({
            t: Math.round(performance.now()),
            point: point,
            scrollY: window.scrollY,
            scrimOpacity: scrimEl ? getComputedStyle(scrimEl).opacity : '-',
            // COMPUTED opacity is the animating value; INLINE is what JS
            // actually wrote. If inline reads '1' while computed is still
            // climbing, the CSS transition is running (instant path failed).
            // If BOTH read '1' from the first sample, opacity is not what's
            // fading — the visible ramp is then the colour crossfade
            // (gradflow-color-crossfade.js, 700ms) instead.
            gfOpacityComputed: gradflowEl ? getComputedStyle(gradflowEl).opacity : '-',
            gfOpacityInline: gradflowEl ? (gradflowEl.style.opacity || '(unset)') : '-',
            gfDisplay: gradflowEl ? getComputedStyle(gradflowEl).display + '/' + getComputedStyle(gradflowEl).visibility : '-',
            // The OTHER things layered over the gradflow canvas. If none of
            // the gradflow fields animate but one of these does, the "fade
            // in" being seen is that element revealing the canvas, not the
            // canvas itself appearing. html.curtain-restoring hides .home
            // (main.css) and is dropped by runCurtainEntrance.
            homeOpacity: (function () {
              var h = document.querySelector('.home');
              return h ? getComputedStyle(h).opacity : '-';
            })(),
            htmlClasses: document.documentElement.className || '(none)',
            // Live shader uniform (what the colour system THINKS is set).
            gfColor1: (function () {
              try {
                var c = document.querySelector('.gradflow-page-bg-canvas');
                var u = c && c.__gradflowHandle && c.__gradflowHandle.__debugColor1;
                return u ? u.join(',') : (c && c.__gradflowHandle ? 'handle-no-debug' : 'no-handle');
              } catch (err) { return 'err'; }
            })(),
            // GROUND TRUTH: the actual pixel currently rendered in the
            // canvas's own drawing buffer, read back from the GPU. Unlike
            // every other field here this cannot be fooled by opacity, by
            // uniforms that were set but never drawn, or by a frame that
            // hasn't been rendered yet — if this is transparent/black the
            // canvas is genuinely painting nothing on screen, whatever the
            // CSS says. preserveDrawingBuffer is NOT set on this context, so
            // a readback outside the render tick can legitimately come back
            // cleared; treated as informative, not authoritative, for that
            // reason — a STABLE non-zero value is the meaningful signal.
            gfPixel: (function () {
              try {
                var c = document.querySelector('.gradflow-page-bg-canvas');
                if (!c) return '-';
                var gl = c.getContext('webgl2', { preserveDrawingBuffer: true })
                      || c.getContext('webgl', { preserveDrawingBuffer: true });
                if (!gl) return 'no-gl';
                var px = new Uint8Array(4);
                gl.readPixels(Math.floor(c.width / 2), Math.floor(c.height / 2), 1, 1, gl.RGBA, gl.UNSIGNED_BYTE, px);
                return px[0] + ',' + px[1] + ',' + px[2] + ' a' + px[3];
              } catch (err) { return 'err:' + err.message; }
            })(),
          });
        };
        // Records only when something actually changed since the last row —
        // see the poll in page-transition.js for why (a per-frame capture
        // over a 2.5s window is otherwise ~150 identical rows).
        window.__flashdiagSnapIfChanged = function (point) {
          var arr = window.__flashdiag;
          var beforeLen = arr.length;
          window.__flashdiagSnap(point);
          if (beforeLen === 0) return;
          var prev = arr[beforeLen - 1];
          var next = arr[arr.length - 1];
          var same = Object.keys(next).every(function (k) {
            return k === 't' || k === 'point' || String(prev[k]) === String(next[k]);
          });
          if (same) arr.pop();
        };
        window.__flashdiagSnap('head-inline-script-end');
      }
      // TEMPORARY DIAGNOSTIC (2026-08-19) — REMOVE with the rest of the
      // ?flashdiag=1 instrumentation.
      // Standalone timeline recorder for the "gradflow fades in on curtain
      // return" report. Deliberately OUTSIDE the ?flashdiag=1 gate above:
      // a curtain return lands on a plain '/' with no query string, so
      // anything defined inside that gate simply does not exist on the page
      // where the problem happens (which is why the first version of this
      // never ran). Auto-starts below off the curtainReturn sessionStorage
      // flag instead. Records every frame for 4s — longer than the earlier
      // 600ms/2.5s windows, which may have ended before the reported ~1s
      // sequence finished — and prints a compact table of only the rows
      // where the composited result actually changed.
      window.__gfWatch = function (ms) {
        var rows = [];
        var t0 = performance.now();
        var lastKey = '';
        (function step() {
          var el = document.querySelector('.gradflow-page-bg');
          var cv = document.querySelector('.gradflow-page-bg-canvas');
          var px = '-';
          try {
            if (cv) {
              var gl = cv.getContext('webgl2', { preserveDrawingBuffer: true })
                    || cv.getContext('webgl', { preserveDrawingBuffer: true });
              if (gl) {
                var b = new Uint8Array(4);
                gl.readPixels(Math.floor(cv.width / 2), Math.floor(cv.height / 2), 1, 1, gl.RGBA, gl.UNSIGNED_BYTE, b);
                px = b[0] + ',' + b[1] + ',' + b[2] + ' a' + b[3];
              }
            }
          } catch (e) { px = 'err'; }
          var scrimEl2 = document.getElementById('pt-scrim');
          var row = {
            t: Math.round(performance.now() - t0),
            gfOpacity: el ? getComputedStyle(el).opacity : '-',
            gfPixel: px,
            scrim: scrimEl2 ? getComputedStyle(scrimEl2).opacity : '-',
            particles: (function () {
              var p = document.getElementById('particle-morph-demo') || document.getElementById('gpu-canvas');
              return p ? getComputedStyle(p).opacity : '-';
            })(),
          };
          // Ignore 1-unit shader jitter so it doesn't force a row every frame.
          var key = row.gfOpacity + '|' + row.gfPixel.replace(/\d+/g, function (n) { return Math.round(n / 8); }) + '|' + row.scrim + '|' + row.particles;
          if (key !== lastKey) { lastKey = key; rows.push(row); }
          if (performance.now() - t0 < (ms || 4000)) requestAnimationFrame(step);
          else { console.table(rows); window.__gfWatchRows = rows; }
        })();
        return 'watching ' + (ms || 4000) + 'ms — table prints when done';
      };
      // Auto-start on a curtain return: this is a real navigation, so
      // anything started by hand on the post page is gone by now. The flag
      // is still in sessionStorage at this point (page-transition.js's
      // runCurtainEntrance consumes it later, on DOMContentLoaded), so
      // reading it here is the earliest reliable "this load is a return".
      try {
        if (sessionStorage.getItem('curtainReturn') === '1') {
          document.addEventListener('DOMContentLoaded', function () { window.__gfWatch(4000); });
        }
      } catch (e) {}
    })();
  </script>
  <script src="{{asset "js/device-capability.js"}}?v={{@site.updated_at}}"></script>
  <style>
    /* Defensive anti-flash fallback: ROOT background only, before CSS loads.
       Hexes are manual copies of tokens.css --theme-*-bg — keep in sync.
       NO body rules here ON PURPOSE (invariant 2 in the script above):
       body stays transparent so the fixed #page-backdrop can carry the
       scroll-driven palette shift. The html background covers pre-CSS flash. */
    html { background-color: #1d1e1f; }
    html[data-theme='light'] { background-color: #FAFAF8; }
    html[data-theme='dim'] { background-color: #1d1e1f; }

    /* #preloader { display: none !important; } REMOVED 2026-08-06 — it had
       no lifting mechanism anywhere (unlike every other pre-hide veil in
       this codebase — landing-pending/main-pending/curtain-restoring —
       which are all scoped to an html class and explicitly removed by JS
       once real content takes over). An ID selector + !important beats
       .preloader's own `display: flex` (main.css) regardless of source
       order, and nothing ever countered it: the ENTIRE preloader — wordmark,
       dot bounce, burst sequence, and the indeterminate loading bar — has
       been invisible on every load, full-run and skip-path alike. Confirmed
       live: a fresh homepage load's #preloader computed to display:none the
       whole time, before this fix.
       It's also redundant, which is presumably why nobody had reason to add
       the missing lift: main.css is a normal render-blocking <link> (loads
       before <body> paints), so the raw unstyled section could never flash
       regardless of this rule; and .preloader's own opacity:0 + 0.4s
       preloaderFadeIn (main.css) already handles a clean no-flash reveal on
       its own. The skip path still hides it correctly without this —
       preloader.js sets a plain (non-!important) inline display:none there,
       which now applies normally with the blocking !important gone; and
       .preloader's own opacity:0 base state covers the moment before that
       JS runs, same safety net a fresh/full-run load relies on. */

    /* Navigation visible immediately — no blink, no animation */
    .gh-navigation {
      animation: none !important;
      opacity: 1 !important;
      visibility: visible !important;
      pointer-events: auto !important;
    }
  </style>
