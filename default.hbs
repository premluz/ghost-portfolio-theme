      // is answered. Enable with ?pdiag=1. console.error, not console.log:
      // console.log is a no-op on this theme unless window.DEBUG_SCROLL is
      // set (see the console gate IIFE below). Reports every apply() call
      // that survives the guards above, and whether it resolves to a hide
      // or a show — so the caller that re-shows the layer names itself
      // instead of being guessed at.
      if (/[?&]pdiag=1/.test(location.search)) {
        const _t = (scen[key] === undefined || scen[key] === '') ? builtinShape : scen[key];
        console.error('[PDIAG] key=' + key + '  builtin=' + builtinShape +
          '  ->resolved=' + _t + '  ' + (_t === 'hide' ? '(HIDE)' : '(SHOW)') +
          '  scrollY=' + Math.round(window.scrollY));
