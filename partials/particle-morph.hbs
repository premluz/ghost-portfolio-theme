            { at: 0.00, position: [0, -6.0, 0] },
            { at: 0.08, shape: 'grid' },
            { at: 0.42, position: [0, -2.5, 0] },
          ], {
            element: footerSection,
            shapeKey: 'footer',
            // 1100ms (was 600): the ribbon -> grid morph read as an abrupt
            // snap rather than a settle. Not pushed further — at ~2000px/s
            // a 1600ms morph spans ~3200px, more than the footer zone's own
            // ~2150px range, so on the way back UP it could still be
            // running as the zone hands over. 1100ms leaves headroom.
            morphMs: 1100,
            // Returns to the HERO's own shape rather than 'terrain'.
