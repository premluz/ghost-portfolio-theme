        const footerSection = document.getElementById('footer');
        if (footerSection) {
          // Shape keyframe added here (was a separate IntersectionObserver
          // further down — see its own removal note): a SINGLE keyframe at
          // t=0.08 (~matches the old >10%-visible threshold — retune if it
