          // rawT crosses zero the moment Lab's element top merely touches
          // the viewport bottom, which happens while hero is still mid-drift
          // and would hand over early — the same mistake that once froze Lab
          // after a single frame. 0.02 is where Lab actually claims the
          // shape, so it's where it should claim position too.
          // The Lab release does NOT apply once hero's own shape is the
          // current one. Coming back up, the footer's reverseExit completes
          // while still inside Lab's range: without this, hero owned
          // position through the morph, lost it the instant the morph
          // finished, then reclaimed it again further up — two jumps on the
          // way back. Lab has no shape of its own to position any more (its
          // keyframes are commented out above), so if hero's shape is what
          // is showing, hero should be placing it.
          const heroShapeCurrent = cur && cur.id === base;
          const labZone = window.particleScrollDirector
            && window.particleScrollDirector.zones.get('lab');
