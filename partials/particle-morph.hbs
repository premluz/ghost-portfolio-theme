          window.particleScrollDirector.setZone('lab', [
            // Position keyframes disabled with the frame() below: without
            // frame(), positionBase falls back to [0,0,0] and these would
            // still drag the object onto Lab's own coordinates — the same
            // jump by a different route. With both off the zone writes no
            // position at all and hero's placement carries through.
            // { at: 0.00, position: [0, -6.0, 0] },
            // TEMPORARILY DISABLED alongside hero's own exit-shape keyframe
            // (see particle-morph.hbs's heroKeyframes section): with hero no
