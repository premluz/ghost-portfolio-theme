  // bleed makes light-mode particles feel too heavy. Dark mode always
  // runs the base strength. Live-tune:
  //   window.particleSystem.updateColors() re-applies after edits here;
  //   or set the uniform directly for a quick look.
  //
  // WHY STRENGTH DROPPED 1.5 -> 1.0 WHILE RADIUS WENT UP (2026-08-05):
  // "light mode barely visible" measured out as a COVERAGE deficit, not a
  // brightness one. Against dark mode as the target, light mode already
  // matched on raw core contrast but lit only 0.80% of pixels past a
  // 2-deltaL JND vs dark's 2.28% — the cores were fine, the halo/dust
  // around them died against white. Strength alone cannot fix that: it
  // drives the core's peak, and pushing it far enough to spread coverage
  // blew the cores to deltaL 45-58 (target 22.4) while coverage stalled
  // near 1.3%, because coverage is bounded by the halo's FOOTPRINT, not
  // its intensity. Widening the radius spreads the same ink over more
  // pixels, so strength could come back down to the base. Measured pairs
  // (colour #082A3C, see --color-particles in default.hbs — the three
  // knobs were tuned together and only make sense together):
  //   strength 1.5, radius 2.8  -> core 25.9, coverage 1.05%   (old shape)
  //   strength 2.0, radius 2.8  -> core 42.8, coverage 1.39%   (blown cores)
  //   strength 1.0, radius 5.2  -> core 24.2, coverage 2.29%   (chosen)
  // Dark mode is untouched by both multipliers (x1.0).
  var GLOW_STRENGTH_LIGHT_MULT = 1.0;

  // Light-mode halo footprint, as a multiple of the base GLOW_RADIUS
  // (particle-animation-loop.js). 5.2 / 2.8 — see the measurements above.
  // COST: sprite area scales with the square of this (setGlowRadius keeps
  // uSpriteScale = radius * 2.12 in lockstep), so light mode pays ~3.4x the
  // per-particle fill of dark mode. Deliberate and bounded: it multiplies
  // whatever base radius this device got, and low-end devices start from a
  // much smaller one (1.1 vs 2.8), so a low-end light sprite still ends up
  // SMALLER than a normal dark-mode sprite is today — the weakest GPUs
  // never see the full cost.
  var GLOW_RADIUS_LIGHT_MULT = 5.2 / 2.8;

  function applyTheme() {
    var isLight = document.documentElement.getAttribute('data-theme') === 'light';
    var geo = loop.particles && loop.particles.geometry;

    // Update colour buffer with correct count + working colour reader
    if (geo && geo.attributes.position) {
      var count  = geo.attributes.position.count;
      var colors = generateColors(count);
      if (geo.attributes.color && geo.attributes.color.array.length === colors.length) {
        geo.attributes.color.array.set(colors);
        geo.attributes.color.needsUpdate = true;
      } else if (geo.attributes.color) {
        geo.setAttribute('color', new THREE.BufferAttribute(colors, 3));
        geo.attributes.color.needsUpdate = true;
      }
      console.log('[particle-theme-patch] color updated, isLight=' + isLight +
                  ' count=' + count +
                  ' sample=[' + Array.from(colors.slice(0, 3)).map(function(v){ return v.toFixed(3); }) + ']');
    }

    // Per-theme glow trim (see GLOW_STRENGTH_LIGHT_MULT above). Base
    // strength is captured once so repeated applyTheme calls (every shift
    // tick + theme toggles) can't compound the multiplier.
    var u = loop.particles && loop.particles.material && loop.particles.material.uniforms;
    if (u && u.uGlowStrength) {
      if (loop.__baseGlowStrength === undefined) loop.__baseGlowStrength = u.uGlowStrength.value;
      u.uGlowStrength.value = loop.__baseGlowStrength * (isLight ? GLOW_STRENGTH_LIGHT_MULT : 1.0);
    }

    // Halo footprint, same base-capture guard as the strength above (this
    // runs on every palette-shift tick, so reading the LIVE radius as the
    // base would compound the multiplier on the second call). setGlowRadius
    // is what keeps uSpriteScale in lockstep — writing uGlowRadius alone
    // just clips the halo at the old sprite bounds.
    if (u && u.uGlowRadius && loop.setGlowRadius) {
      if (loop.__baseGlowRadius === undefined) loop.__baseGlowRadius = u.uGlowRadius.value;
      loop.setGlowRadius(loop.__baseGlowRadius * (isLight ? GLOW_RADIUS_LIGHT_MULT : 1.0));
    }

    // Defensive: enforce the single-pipeline invariants in case any other
    // code (old cached JS, console experiments) flipped them.
    loop.renderer.setClearColor(0x000000, 0);
    if (demo) {
      demo.style.mixBlendMode = 'normal';
      demo.style.filter = 'none';
      // Don't force the layer visible if a PARTICLE_SCENARIO has hidden it —
      // this runs from updateColors() on EVERY palette-shift scroll frame
      // (profile section), and unconditionally writing '1' here was
      // silently undoing scenario 'hide' fades mid-page.
      if (!window.__particleLayerHidden) demo.style.opacity = '1';
    }
  }

  sys.updateColors = applyTheme;
  applyTheme();
  debug('[particle-morph] theme patch installed');
}());
</script>
