  var sys = window.particleSystem;
  if (!sys || !sys.loop || !sys.loop.particles) {
    setTimeout(installThemePatch, 300);
    return;
  }

  var loop = sys.loop;
  var demo = document.getElementById('particle-morph-demo');

  // ── Robust colour reader (canvas, works for hex/rgb/named) ──────────────
  function readCSSColor(variable) {
    var raw = getComputedStyle(document.documentElement).getPropertyValue(variable).trim();
    // Fallback matches --color-particles' own DARK-theme value (#1D4551, default.hbs)
    // rather than an arbitrary bright cyan (90,216,255) — this is the base colour
    // generateColors() jitters/accents on top of, so a wrong value here isn't subtle:
    // it repaints the whole sphere. If the CSS var ever genuinely reads empty (see
    // particle-morph-system.js's generateParticleColors for the same reasoning), fail
    // toward the theme's real colour instead of an off-brand flash.
    if (!raw) return [29/255, 69/255, 81/255];
    var cvs = document.createElement('canvas');
    cvs.width = cvs.height = 1;
    var ctx = cvs.getContext('2d');
    ctx.fillStyle = raw;
    ctx.fillRect(0, 0, 1, 1);
    var d = ctx.getImageData(0, 0, 1, 1).data;
    return [d[0]/255, d[1]/255, d[2]/255];
  }

  // Per-particle colour variance (DNA-Capital look): mostly the base
  // --color-particles hex with slight brightness jitter, a scatter of
  // accent colours, and a handful of bright sparkles whose indices match
  // the oversized dots in shape-definitions.js's helix lattice (identical
  // index hash + threshold), so the big dots are the bright ones.
  // Deterministic per index — applyTheme re-runs constantly (shift ticks,
  // toggles) and the field must not shimmer between calls.
  //
  // ── TUNE HERE ─────────────────────────────────────────────────────────
  // hex, not the 0-1 fractions the old ACCENT_A/ACCENT_B literals used —
  // matches how every other colour in this codebase (--color-particles
  // included) is authored, so no fraction<->hex conversion needed to try a
  // new accent. Order matters for `share` below: FIRST entry claims the
  // hash slice immediately below sparkle's threshold, each entry after it
  // claims the next slice further down — so this list reads top-to-bottom
  // as "rarest accent first," matching the original hardcoded thresholds
  // (pink was the rarer 0.92-0.995 band, violet the larger 0.80-0.92 one
  // below it) exactly. Add/remove/reorder entries and the thresholds
  // recompute themselves — no separate threshold constant to keep in sync
  // by hand.
  var PARTICLE_ACCENTS = {
    colors: [
      { hex: '#e07ab0', share: 0.075 },  // pink   (rarer — was h > 0.92)
      { hex: '#8c7df5', share: 0.12  },  // violet (below it — was h > 0.80)
    ],
    // How strongly an accent replaces the base colour at its hash slice —
    // 1.0 = pure accent, 0.0 = no visible effect at all.
    blendStrength: 0.55,
    // ± range for the brightness jitter applied to every NON-accent,
    // non-sparkle particle (the large majority). 0.28 total width here
    // means each particle lands somewere in [0.86, 1.14] of base
    // brightness — see the `j` line below.
    jitterRange: 0.28,
    jitterFloor: 0.86,
    // Sparkle threshold + warmth. THRESHOLD IS PINNED, not a tuning knob:
    // it must equal shape-definitions.js's own oversized-dot threshold
    // (search that file for the matching index-hash check) so the bright
    // sparkles line up with the physically larger dots. Changing this
    // number here without changing it there decouples the two — sparkles
    // and big dots would stop matching up.
    sparkleThreshold: 0.995,
    // 0 = accent-tinted colour (base/pink/violet, boosted, no white mixed
    // in), 1 = pure white, regardless of the sparkle's own colour. Split
    // per theme (2026-08-27) — dark's 0.65 was already the tuned/liked
    // value and stays; light mode at the same 0.65 read as a genuinely
    // WHITE fleck against the light page background (nothing else in this
    // config is theme-aware, so light inherited dark's warmth unchanged),
    // reported as "should not be light/whiteish, more blue with a pink/
    // purple note" — i.e. sparkles should still read as the SAME hue
    // family as the rest of the particles (navy base + pink/violet
    // accents), just brighter, not shift toward a separate white. Lower
    // value (0.3) keeps meaningfully more of the boosted base/accent
    // colour in the mix instead of washing it out.
    sparkleWarmth: 0.65,
    sparkleWarmthLight: 0.3,
    sparkleBoost: 2.2,     // brightness multiplier before the warmth mix
  };

  function hexToRgb01(hex) {
    var v = parseInt(hex.replace('#', ''), 16);
    return [((v >> 16) & 255) / 255, ((v >> 8) & 255) / 255, (v & 255) / 255];
  }

  function hash01(i) {
    var x = Math.sin(i * 127.1) * 43758.5453;
    return x - Math.floor(x);
  }
  function generateColors(count, isLight) {
    var c = readCSSColor('--color-particles');
    var cfg = PARTICLE_ACCENTS;
    // Resolve each accent's hash-space slice at call time, not module load
    // — cheap (runs once per generateColors() call, not per particle) and
    // means editing PARTICLE_ACCENTS.colors above needs no threshold math.
    // Slices stack from the TOP of the hash range down: sparkle claims the
    // very top (pinned, see cfg.sparkleThreshold), then each accent in
    // array order claims the next band below it.
    var bands = [];
    var upper = cfg.sparkleThreshold;
    for (var a = 0; a < cfg.colors.length; a++) {
      var rgb = hexToRgb01(cfg.colors[a].hex);
      var lower = upper - cfg.colors[a].share;
      bands.push({ rgb: rgb, lower: lower, upper: upper });
      upper = lower;
    }
    var arr = new Float32Array(count * 3);
    for (var i = 0; i < count; i++) {
      var h = hash01(i);
      var r = c[0], g = c[1], b = c[2];
      if (h > cfg.sparkleThreshold) {
        // sparkle: hot, pulled toward white/colour depending on theme
        // (matches the oversized dots — threshold MUST equal the sizes
        // threshold in shape-definitions.js). Light mode uses a lower
        // warmth (sparkleWarmthLight) so the brightest particles stay
        // visibly blue/violet-tinted instead of washing out to white
        // against the light page background — see that value's own
        // comment above for why dark mode is untouched.
        var wm = isLight ? cfg.sparkleWarmthLight : cfg.sparkleWarmth;
        r = r * cfg.sparkleBoost * (1 - wm) + wm;
        g = g * cfg.sparkleBoost * (1 - wm) + wm;
        b = b * cfg.sparkleBoost * (1 - wm) + wm;
      } else {
        var matched = null;
        for (var bi = 0; bi < bands.length; bi++) {
          if (h > bands[bi].lower && h <= bands[bi].upper) { matched = bands[bi]; break; }
        }
        if (matched) {
          var s = cfg.blendStrength;
          r = r * (1 - s) + matched.rgb[0] * s;
          g = g * (1 - s) + matched.rgb[1] * s;
          b = b * (1 - s) + matched.rgb[2] * s;
        } else {
          // base with jitter (second hash decorrelates from the band pick above)
          var j = cfg.jitterFloor + hash01(i + 31) * cfg.jitterRange;
          r *= j; g *= j; b *= j;
        }
      }
      arr[i*3] = r; arr[i*3+1] = g; arr[i*3+2] = b;
    }
    return arr;
  }

  // ── SINGLE PIPELINE (2026-07-17): transparent canvas + normal element
  // compositing, both themes, at every shift value. The old dual pipeline
  // (opaque-black canvas + mix-blend-mode:screen in dark mode) existed
  // solely so UnrealBloomPass had an opaque buffer to composite; bloom is
  // gone (replaced by in-sprite glow in particle-animation-loop.js's
  // fragment shader), so the 0.65 shift-threshold pipeline flip, the
  // black-flash bridge frame, the composer interceptor getters and the
  // canvas opacity dip that smoothed the flip are all obsolete and removed.
  // Particles now render identically over any backdrop — dark, light, or
  // mid-shift — and macOS rubber-band overscroll can never expose an opaque
  // black buffer again (there isn't one).
  // Per-theme glow trim: the in-sprite halo composites in OPPOSITE
  // directions per theme — luminous glow over dark backgrounds, soft dark
  // ink-bleed over light ones (same shader, the backdrop flips the read).
  // 1.0 = light mode keeps the full halo; lower it (e.g. 0.5) if the
  // bleed makes light-mode particles feel too heavy. Dark mode always
  // runs the base strength. Live-tune:
  //   window.particleSystem.updateColors() re-applies after edits here;
  //   or set the uniform directly for a quick look.
  //
  // WHY STRENGTH DROPPED 1.5 -> 1.0 WHILE RADIUS WENT UP (2026-08-05):
  // "light mode barely visible" measured out as a COVERAGE deficit, not a
  // brightness one. Against dark mode as the target, light mode already
  // matched on raw core contrast but lit only 0.80% of pixels past a
  // 2-deltaL JND vs dark's 2.28% — the cores were fine, the halo/dust
  // around them died against white. Strength alone cannot fix that: it
  // drives the core's peak, and pushing it far enough to spread coverage
  // blew the cores to deltaL 45-58 (target 22.4) while coverage stalled
  // near 1.3%, because coverage is bounded by the halo's FOOTPRINT, not
  // its intensity. Widening the radius spreads the same ink over more
  // pixels, so strength could come back down to the base. Measured pairs
  // (colour #082A3C, see --color-particles in default.hbs — the three
  // knobs were tuned together and only make sense together):
  //   strength 1.5, radius 2.8  -> core 25.9, coverage 1.05%   (old shape)
  //   strength 2.0, radius 2.8  -> core 42.8, coverage 1.39%   (blown cores)
  //   strength 1.0, radius 5.2  -> core 24.2, coverage 2.29%   (chosen)
  // Dark mode is untouched by both multipliers (x1.0).
  // Was dropped 1.0 -> 0.25 (2026-08-31) to fix "too strong" light-mode
  // bloom, then reverted back to 1.0 the same day per explicit request —
  // the actual bloom-strength fix approach changed direction to CORE_MULT_
  // LIGHT_MULT/HALO_MULT_LIGHT_MULT below (tune the particles' own colour/
  // brightness before additive summation) rather than fading overall glow
  // strength/alpha, which also worked but wasn't the preferred lever. The
  // dark->light "bloom persists after toggle" bug this comment used to
  // reference was separately fixed for real via loop.applyThemeBlending()
  // now being called from this same function (see further down) — additive
  // vs normal blending was the actual stuck-state cause, not this value.
  var GLOW_STRENGTH_LIGHT_MULT = 1.0;

  // Light-mode halo footprint, as a multiple of the base GLOW_RADIUS
  // (particle-animation-loop.js).
  // Was 5.2/2.8 (~1.86x dark mode's own radius) — that coverage fix solved
  // "light mode barely visible" but is exactly what made every particle
  // read as a soft, blown-up, blurry blob instead of a crisp dot: sprite
  // area scales with the SQUARE of this multiplier, so 1.86x radius was
  // ~3.4x the per-particle fill of dark mode. Screenshotted side-by-side
  // 2026-08-31 — dark mode is "crisp with subtle aura", light mode was
  // visibly soft/blurry by comparison. Dropped to 1.0 (matches dark mode's
  // own sprite size exactly) to fix the crispness gap; visibility is
  // carried by CORE_MULT_LIGHT_MULT/HALO_MULT_LIGHT_MULT instead (weaker
  // additive contrast doesn't need a bigger sprite to be visible dark on
  // light, only enough alpha/colour weight in the same footprint).
  var GLOW_RADIUS_LIGHT_MULT = 1.0;

  // HDR core/halo overbright trim, light mode only (see the applyTheme()
  // block below that reads these). 1.0 = untouched (original hardcoded
  // 1.8/1.5 everywhere, both themes).
  // Tuned down to 0.7 (2026-08-27, was the no-op 1.0 default): confirmed
  // live — a single particle's core/halo colour was never literally white
  // on its own (navy #082A3C * 1.8 core / * 1.5 halo tops out around
  // rgb(0.06, 0.30, 0.42), nowhere near white) — the bloom in the reported
  // screenshot is ADDITIVE ACCUMULATION: many overlapping halos summing
  // per-channel, clamped at 1.0, blows out toward white wherever enough of
  // them overlap, regardless of the per-particle hue driving it. This dial
  // scales every particle's own core/halo intensity down BEFORE that
  // summation, so less overlap ever reaches the clamp ceiling — reduces
  // the systemic overexposure without touching the sparkle-tier fix
  // (PARTICLE_ACCENTS.sparkleWarmthLight above, a separate, unrelated
  // white source: that one controls a single particle's own colour choice,
  // this controls how bright ANY particle's glow gets before summing with
  // its neighbours). Dark mode is never touched by either multiplier.
  // CORE raised 0.7 -> 1.0 (2026-08-31, paired with GLOW_RADIUS_LIGHT_MULT
  // dropping to 1.0 above): with the sprite no longer inflated to ~1.86x
  // dark mode's radius, the dots need their full core weight to read as
  // crisply as dark mode's own dots do — this was compensating for a
  // now-removed coverage boost, not an independent trim.
  var CORE_MULT_LIGHT_MULT = 1.0;
  // HALO kept low, 0.35 (2026-08-31) — this is now what makes light mode
  // match dark mode's "crisp dot, SUBTLE aura" feel: a small, tight sprite
  // (GLOW_RADIUS_LIGHT_MULT 1.0) with a light halo weight reads as a sharp
  // core with a soft ring around it, not a blown-up blurry blob. Only
  // scales the halo term (particle-style-definitions.js,
  // `vColor * uHaloMult * halo`) — core dot visibility above is untouched.
  var HALO_MULT_LIGHT_MULT = 0.35;

  function applyTheme() {
    var isLight = document.documentElement.getAttribute('data-theme') === 'light';
    var geo = loop.particles && loop.particles.geometry;

    // Update colour buffer with correct count + working colour reader
    if (geo && geo.attributes.position) {
      var count  = geo.attributes.position.count;
      var colors = generateColors(count, isLight);
      if (geo.attributes.color && geo.attributes.color.array.length === colors.length) {
        geo.attributes.color.array.set(colors);
        geo.attributes.color.needsUpdate = true;
      } else if (geo.attributes.color) {
        geo.setAttribute('color', new THREE.BufferAttribute(colors, 3));
        geo.attributes.color.needsUpdate = true;
      }
      console.log('[particle-theme-patch] color updated, isLight=' + isLight +
                  ' count=' + count +
                  ' sample=[' + Array.from(colors.slice(0, 3)).map(function(v){ return v.toFixed(3); }) + ']');
    }

    // Per-theme glow trim (see GLOW_STRENGTH_LIGHT_MULT above). Base
    // strength is captured once so repeated applyTheme calls (every shift
    // tick + theme toggles) can't compound the multiplier.
    var u = loop.particles && loop.particles.material && loop.particles.material.uniforms;
    if (u && u.uGlowStrength) {
      if (loop.__baseGlowStrength === undefined) loop.__baseGlowStrength = u.uGlowStrength.value;
      u.uGlowStrength.value = loop.__baseGlowStrength * (isLight ? GLOW_STRENGTH_LIGHT_MULT : 1.0);
    }

    // Halo footprint, same base-capture guard as the strength above (this
    // runs on every palette-shift tick, so reading the LIVE radius as the
    // base would compound the multiplier on the second call). setGlowRadius
    // is what keeps uSpriteScale in lockstep — writing uGlowRadius alone
    // just clips the halo at the old sprite bounds.
    if (u && u.uGlowRadius && loop.setGlowRadius) {
      if (loop.__baseGlowRadius === undefined) loop.__baseGlowRadius = u.uGlowRadius.value;
      loop.setGlowRadius(loop.__baseGlowRadius * (isLight ? GLOW_RADIUS_LIGHT_MULT : 1.0));
    }

    // HDR core/halo overbright trim (uCoreMult/uHaloMult, particle-
    // animation-loop.js). Same base-capture guard as strength/radius above.
    // Dark mode's near-black backdrop lets ACES roll the same overbright
    // into a natural bloom; light mode's near-white backdrop reads it as a
    // flat white core instead — see COLOR-TUNING.md. 1.0 = untouched
    // (matches the original hardcoded 1.8/1.5 exactly); lower toward 1.0
    // (no HDR push at all) if light-mode cores still read too white.
    if (u && u.uCoreMult) {
      if (loop.__baseCoreMult === undefined) loop.__baseCoreMult = u.uCoreMult.value;
      u.uCoreMult.value = loop.__baseCoreMult * (isLight ? CORE_MULT_LIGHT_MULT : 1.0);
    }
    if (u && u.uHaloMult) {
      if (loop.__baseHaloMult === undefined) loop.__baseHaloMult = u.uHaloMult.value;
      u.uHaloMult.value = loop.__baseHaloMult * (isLight ? HALO_MULT_LIGHT_MULT : 1.0);
    }

    // Lab wave tint (uWaveColor) — per-theme, same CSS-var-driven pattern
    // as the particle base colour. Falls back to the uniform's own current
    // value (no-op) if the token isn't set, rather than guessing a colour.
    if (u && u.uWaveColor) {
      var rawWave = getComputedStyle(document.documentElement)
        .getPropertyValue('--color-particles-wave').trim();
      if (rawWave) u.uWaveColor.value.set(rawWave);
    }

    // Blending mode (2026-08-31 fix): additive blending sums particle light
    // into the background — reads as bloom/glow on dark's near-black
    // backdrop, but washes the whole shape toward white on light's
    // near-white one, independent of anything the glow-strength/radius/
    // core/halo multipliers above tune. particle-animation-loop.js's
    // applyThemeBlending() sets NormalBlending for light / AdditiveBlending
    // for dark, but this function was the only theme-change entry point
    // that never called it (its own doc comment refers to a DIFFERENT,
    // no-longer-loaded updateColors() in particle-morph-system.js that did)
    // — so blending only ever got set correctly once, at page-load init,
    // and stayed stuck at that value through every later toggle. Confirmed
    // as the actual cause of "toggling dark->light leaves dark's bloom,
    // but a fresh light-mode load looks correct": a fresh load's init call
    // reads isLight right for that page's own starting theme; a toggle
    // changed data-theme but never re-ran this, so an AdditiveBlending
    // material carried over unchanged into light mode.
    if (loop.applyThemeBlending) loop.applyThemeBlending();

    // Defensive: enforce the single-pipeline invariants in case any other
    // code (old cached JS, console experiments) flipped them.
    loop.renderer.setClearColor(0x000000, 0);
    if (demo) {
      demo.style.mixBlendMode = 'normal';
      demo.style.filter = 'none';
      // Don't force the layer visible if a PARTICLE_SCENARIO has hidden it —
      // this runs from updateColors() on EVERY palette-shift scroll frame
      // (profile section), and unconditionally writing '1' here was
      // silently undoing scenario 'hide' fades mid-page.
      //
      // Must test __particleHiding TOO, not just __particleLayerHidden.
      // __particleLayerHidden only flips true from the hide TIMER, ~700ms
      // after a fade is armed (default.hbs __particleApply), so for that
      // whole window a fade is visibly in flight while the flag still reads
      // false — and this line then stomps opacity back to '1' and cancels it.
      //
      // That is the "click Home, scroll immediately, hero's ground plane
      // ('terrain', the surface) stays on screen" bug. Traced by trapping
      // writes to this element's style.opacity: the hide wrote '0' at
      // t=1513ms and applyTheme wrote '1' at t=1532ms, 19ms later. Land the
      // same scroll after the theme patch has already run (t=1271ms vs a
      // hide at t=1614ms) and the order reverses, which is exactly why it
      // only reproduced when scrolling within ~400ms of landing.
      //
      // __particleHiding goes true synchronously the instant any hide is
      // requested, so it covers the full fade window the other flag misses.
      if (!window.__particleLayerHidden && !window.__particleHiding) demo.style.opacity = '1';
    }
  }

  sys.updateColors = applyTheme;
  applyTheme();
  debug('[particle-morph] theme patch installed');
}());
</script>
