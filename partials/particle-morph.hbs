            // hero's own canvas offset and zoom in a single frame. That was
            // right while Lab morphed into its own shape there — the reset
            // happened under cover of the morph.
            //
            // With Lab's shape keyframe now commented out, hero's shape
            // simply continues through this range, so there is no morph to
            // mask the reset and it reads as a bare positional jump. Hero's
            // own frame() keeps placing the object instead, which is what
            // the drift to Lab's entry position (CENTER_BY, above) already
            // aims at.
            //
            // Restore alongside Lab's `{ at: 0.02, shape: 'lab' }` keyframe
            // — the two belong together.
            // frame: function (l) {
            //   return {
            //     positionBase: [0, 0, 0],
            //     cameraZ: l._heroBaseCameraZ,
            //     fov: l._baseFov,
            //   };
            // },
            reverseExit: { shape: 'terrain', shapeKey: 'lab-exit', morphMs: 400 },
          });
        }

