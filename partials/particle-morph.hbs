                // x frozen at the hero's own canvas offset — no drift.
                // y rises from that offset by TRAVEL_Y (already "upward"
                // per its own comment) and never reverses direction.
                positionBase: [off.x, off.y + frac * TRAVEL_Y, 0],
                cameraZ: heroBaseCameraZ + (zoomedZ - heroBaseCameraZ) * (frac * frac),
                fov: l._getHeroZoomFov(window.innerWidth),
              };
            }
            // Past EXIT_SPAN: no else-branch needed any more — there is no
            // ongoing drift to keep applying once the buildup completes, so
            // heroFrameFrozen simply holds its last computed value as
            // frame() keeps returning it unchanged.
            return heroFrameFrozen;
          },
        });
      }

