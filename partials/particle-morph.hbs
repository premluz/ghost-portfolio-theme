<div id="particle-morph-demo" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; opacity: 1; pointer-events: none;">
  <div id="particles" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none;"></div>
  {{!-- Covers the particle canvas until the system is ready, then fades
        away — a flat solid-color div, not the canvas's own opacity. A
        WebGL canvas that's actively re-rendering every frame is expensive
        to ALSO animate opacity on (the browser has to composite an
        alpha-blended, per-frame-changing layer); a plain div's opacity is
        cheap regardless of what's happening underneath. See the fade-in
        trigger further down this file for where this actually fades. --}}
  <div id="particles-load-scrim" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; background: var(--color-background); opacity: 1;"></div>
</div>
<script>
  // Failsafe — same principle as every other pre-paint veil on this site
  // (landing-pending/main-pending/curtain-restoring, see LOADING.md): a
  // veil must never depend solely on one path to clear it. This scrim is
  // normally cleared either by the skip-path fade-in trigger further down
  // this file, or by preloader.js's _runParticles() on a full run — if
  // BOTH of those fail to fire for any reason (a stalled GLB/video fetch,
  // a thrown error somewhere in the particle bootstrap chain), the scrim
  // would otherwise sit at opacity:1 forever, permanently hiding the
  // particles behind a solid color — strictly worse than having no scrim
  // at all. Force-clear after 6s regardless of what else has or hasn't run.
  setTimeout(function () {
    var scrim = document.getElementById('particles-load-scrim');
    if (scrim && getComputedStyle(scrim).opacity !== '0') {
      if (window.gsap) window.gsap.to(scrim, { opacity: 0, duration: 0.4 });
      else scrim.style.opacity = '0';
    }
  }, 6000);
</script>

<!-- Load modular particle system -->
<script src="{{asset 'js/particle-state.js'}}"></script>
<script src="{{asset 'js/shape-definitions.js'}}"></script>
<script src="{{asset 'js/dispersed-variants.js'}}"></script>
<script src="{{asset 'js/trigger-system.js'}}"></script>
<script src="{{asset 'js/fade-controller.js'}}"></script>
{{!-- Styles (motion + render treatment) must load BEFORE the animation loop:
      the loop composes its vertex shader from this registry at construction.
      Shapes say where particles rest; styles say how they move. --}}
<script src="{{asset 'js/particle-style-definitions.js'}}"></script>
{{!-- Continuous scroll-driven choreography. Inert until a timeline is set;
      existing morphTo triggers are untouched. --}}
<script src="{{asset 'js/particle-scroll-director.js'}}"></script>
<script src="{{asset 'js/particle-animation-loop.js'}}"></script>
<script src="{{asset 'js/particle-morph-system.js'}}?v={{@site.updated_at}}"></script>

<script>
console.log('[PARTICLE-MORPH] Script executing...');
console.log('[PARTICLE-MORPH] GPU System:', !!window.gpuParticleSystem);
console.log('[PARTICLE-MORPH] THREE:', !!window.THREE);

function debug(msg) {
  console.log(msg);
}

console.log('[PARTICLE-MORPH] Debug function ready');
debug('[particle-morph] 🎬 Initializing modular particle system');
debug('[particle-morph] THREE available: ' + !!window.THREE);
debug('[particle-morph] ParticleMorphSystem available: ' + !!window.ParticleMorphSystem);

// Particles only run on the home page. Skip on: individual post pages
// (post-template), about, contact, and the /work/ index. page-about /
// page-contact are real Ghost body classes for those page templates; the
// /work/ index has no underlying page resource though (it's a custom
// collection route — see routes.yaml), so body_class renders empty there
// and it has to be matched by pathname instead. (Individual project pages
// under /work/{slug}/ are post-template, already caught above.)
const isPostPage = document.body.classList.contains('post-template');
const isAboutPage = document.body.classList.contains('page-about');
const isContactPage = document.body.classList.contains('page-contact');
const isWorkIndexPage = /^\/work\/(page\/\d+\/)?$/.test(window.location.pathname);
// prefers-reduced-motion (see device-capability.js) is an accessibility
// setting, not a performance proxy — always respected regardless of
// hardware, same as the page-type exclusions below. Unlike __lowEndDevice
// (which still gets the hero's helix once, then tears down — see
// setupCardTriggers() gating further down), reduced-motion skips the
// particle system entirely: no motion at all, not even once.
const isPostPageOrExcluded = isPostPage || isAboutPage || isContactPage || isWorkIndexPage || window.__prefersReducedMotion;
if (isPostPageOrExcluded) {
  debug('[particle-morph] ⏸️  Excluded page or prefers-reduced-motion detected — particles disabled');
  // Hide particle container
  const particleContainer = document.getElementById('particle-morph-demo');
  if (particleContainer) {
    particleContainer.style.display = 'none';
  }
  // Exit without initializing
  // Don't throw error, just skip
}

let attempts = 0;
const maxAttempts = 200; // 20 seconds at 100ms intervals

// registerScrollTriggersOnGPU() (the GPU-backend trigger set) was deleted
// here — confirmed 100% dead: gpu-particle-integration is commented out in
// default.hbs, and this function's only call site (below) was itself
// already commented out, so window.gpuParticleSystem is never created and
// this never ran. Its intent now lives in particle-scroll-director.js's
// zones (see setZone() calls below), which work against either backend via
// __particleApply/system.morphTo — no GPU-specific trigger code is needed
// if gpu-particle-integration is ever re-enabled.

async function initParticleMorphModular() {
  // Skip on post/about/contact/work pages — see isPostPageOrExcluded above
  if (isPostPageOrExcluded) return;
  attempts++;

  debug('[particle-morph] Checking for GPU system... gpuParticleSystem=' + (!!window.gpuParticleSystem) + ' particleSystem=' + (!!window.particleSystem));

  // The GPU system initializes asynchronously (after preloader:done + WebGPU
  // adapter setup in gpu-particle-integration.hbs). Checking once at t=0
  // always saw undefined, fell into the old THREE.js path, stalled waiting
  // for window.THREE and never registered any triggers. Wait for it instead —
  // but only if that include is actually present on the page. Without this
  // check, commenting out the gpu-particle-integration partial in default.hbs
  // (the supported way to switch to the old system) silently added a 15s
  // delay before the old system ever started, every single load.
  if (window.__gpuIntegrationPresent) {
    let gpuWaitAttempts = 0;
    while (!window.gpuParticleSystem && gpuWaitAttempts < 150) { // up to 15s
      if (gpuWaitAttempts % 20 === 0) debug('[particle-morph] Waiting for GPU system... (' + (gpuWaitAttempts / 10) + 's)');
      await new Promise(r => setTimeout(r, 100));
      gpuWaitAttempts++;
    }
  } else {
    debug('[particle-morph] gpu-particle-integration not present on this page — skipping GPU wait, going straight to old system');
  }

  // Use GPU system if present and actually supported (not the fallback shim)
  const useGPUSystem = !!window.gpuParticleSystem && window.gpuParticleSystem.isSupported?.() !== false;
  debug('[particle-morph] useGPUSystem=' + useGPUSystem + ', gpuParticleSystem=' + (!!window.gpuParticleSystem) + ', gpuIsSupported=' + (window.gpuParticleSystem?.isSupported?.()));
  if (useGPUSystem) {
    debug('[particle-morph] ✅ GPU system detected — skipping old THREE.js system, scroll triggers will use GPU');
  } else {
    debug('[particle-morph] No GPU system found, will initialize old THREE.js system');
  }

  // Skip old system dependencies if GPU system is available
  if (!useGPUSystem) {
    if (!window.THREE) {
      if (attempts % 20 === 0) debug('[particle-morph] Waiting for THREE... (attempt ' + attempts + ')');
      if (attempts < maxAttempts) {
        setTimeout(initParticleMorphModular, 100);
      } else {
        debug('[particle-morph] ❌ THREE.js failed to load after ' + (maxAttempts * 100) + ' ms');
      }
      return;
    }

    if (!window.StateRegistry) {
      if (attempts % 20 === 0) debug('[particle-morph] Waiting for StateRegistry... (attempt ' + attempts + ')');
      if (attempts < maxAttempts) {
        setTimeout(initParticleMorphModular, 100);
      } else {
        debug('[particle-morph] ❌ particle-state.js failed to load');
      }
      return;
    }

    if (!window.ShapeRegistry) {
      if (attempts % 20 === 0) debug('[particle-morph] Waiting for ShapeRegistry... (attempt ' + attempts + ')');
      if (attempts < maxAttempts) {
        setTimeout(initParticleMorphModular, 100);
      } else {
        debug('[particle-morph] ❌ shape-definitions.js failed to load');
      }
      return;
    }

    if (!window.TriggerManager) {
      if (attempts % 20 === 0) debug('[particle-morph] Waiting for TriggerManager... (attempt ' + attempts + ')');
      if (attempts < maxAttempts) {
        setTimeout(initParticleMorphModular, 100);
      } else {
        debug('[particle-morph] ❌ trigger-system.js failed to load');
      }
      return;
    }

    if (!window.FadeController) {
      if (attempts % 20 === 0) debug('[particle-morph] Waiting for FadeController... (attempt ' + attempts + ')');
      if (attempts < maxAttempts) {
        setTimeout(initParticleMorphModular, 100);
      } else {
        debug('[particle-morph] ❌ fade-controller.js failed to load');
      }
      return;
    }

    if (!window.ParticleAnimationLoop) {
      if (attempts % 20 === 0) debug('[particle-morph] Waiting for ParticleAnimationLoop... (attempt ' + attempts + ')');
      if (attempts < maxAttempts) {
        setTimeout(initParticleMorphModular, 100);
      } else {
        debug('[particle-morph] ❌ particle-animation-loop.js failed to load');
      }
      return;
    }

    if (!window.ParticleMorphSystem) {
      if (attempts % 20 === 0) debug('[particle-morph] Waiting for ParticleMorphSystem... (attempt ' + attempts + ')');
      if (attempts < maxAttempts) {
        setTimeout(initParticleMorphModular, 100);
      } else {
        debug('[particle-morph] ❌ particle-morph-system.js failed to load');
      }
      return;
    }
  }

  debug('[particle-morph] ✅ All modules ready');

  // If GPU system is available, use it; otherwise create old THREE.js system
  let system;

  if (useGPUSystem) {
    debug('[particle-morph] Using GPU system for scroll triggers');
    system = window.gpuParticleSystem;
    window.particleSystem = system; // Compatibility alias for card-animations/main.js
    // (registerScrollTriggersOnGPU() call removed — see the deletion note above initParticleMorphModular())
  } else {
    debug('[particle-morph] Creating ParticleMorphSystem (old THREE.js system)...');

    const container = document.getElementById('particles');
    const demoDiv = document.getElementById('particle-morph-demo');

    if (!container || !demoDiv) {
      debug('[particle-morph] ❌ Missing DOM elements - container: ' + !!container + ' demoDiv: ' + !!demoDiv);
      return;
    }

    try {
      // Detect mobile by viewport width AND touch capability
      const isMobile = window.innerWidth < 768 || window.matchMedia('(max-width: 768px)').matches;
      // Low-end devices get a flat, much lower count regardless of
      // mobile/desktop — with additive blending, overdraw (overlapping
      // transparent points) is the actual cost, not point count alone, so
      // a smaller/sparser field reads almost identically while cutting
      // fill-rate substantially. Only ever matters for the hero's brief
      // one-time helix formation (see setupHeroExitTeardown() below).
      // DNA-Capital-density profile: MANY tiny particles beat fewer big
      // ones on every GPU class — fill (pixels covered) is the real cost,
      // and the finer sizeScale + per-state sizes keep total fill at or
      // below the old 10k budget despite the higher counts.
      // Low-end runs 8k (was 3k): after the DNA-Capital profile landed
      // (bloom deleted, GPU morphs, tiny dots, dpr capped at 1 on low-end)
      // the per-particle cost collapsed — count is vertex work, which even
      // old iGPUs have plenty of; FILL was the killer and fill stays low.
      const particleCount = window.__lowEndDevice ? 8000 : (isMobile ? 5000 : 16000);
      debug(`[particle-morph] Window size: ${window.innerWidth}x${window.innerHeight}`);
      debug(`[particle-morph] ${window.__lowEndDevice ? 'LOW-END' : (isMobile ? 'MOBILE' : 'DESKTOP')} mode - ${particleCount} particles`);

      system = new window.ParticleMorphSystem(container, {
        particleCount: particleCount,
        morphDuration: 1500
      });

      // Wait for async initialization to complete
      await system.initializeModules();
      debug('[particle-morph] Modules initialized');

      // Start with dispersed particles BEFORE registering observers so that any
      // IntersectionObserver callbacks that fire immediately on observation (for
      // elements already in the viewport) see a valid currentState and cannot
      // trigger a morph until the user has actually scrolled past the hero.
      system.start('dispersed');
      debug('[particle-morph] ✅ System initialized and animating');

      // Exposed here (not at the end of setupCardTriggers(), where it used
      // to only happen after every other trigger was registered) so
      // scroll-scrub-anim.js's hero helix-morph poll (which waits
      // specifically for window.particleSystem.morphTo) can find it as
      // early as possible — this must exist even on low-end devices, which
      // skip setupCardTriggers() entirely below but still get the hero's
      // one-time helix formation.
      window.particleSystem = system;
      window.particleMorphSystem = system;

      // HERO ZONE — director-driven replacement for
      // particle-animation-loop.js's old _updateHeroCollapseState()/
      // _applyHeroExitVisuals() (continuous rotation/position/camera-zoom
      // buildup, then a sphere-hide at the collapse threshold). Registered
      // here (not in setupCardTriggers() further down) so it exists before
      // the first scroll-driven frame and before Lab/footer's own setZone
      // calls below — ordering among zones no longer matters functionally
      // (see ownsPosition below), but this mirrors hero's logical priority.
      if (window.particleScrollDirector && system.loop) {
        const loop = system.loop;
        const heroBaseCameraZ = loop.camera.position.z;
        // Fraction of .hero's own height the whole exit buildup (and the
        // collapse trigger) completes within, NOT 1.0 — see the deleted
        // code's own comment history: a separate mechanism (main.js's
        // initHeroFadeOut) sets .hero to display:none well before a full
        // hero-height of scroll, so running the buildup across the full
        // 0-1 range meant most of it played out already hidden.
        const EXIT_SPAN = 0.65;
        const TRAVEL_Y = 2.5;       // world units scrolled upward over the exit
        const ZOOM_FACTOR = 0.72;   // camera distance at collapse, as a fraction of base
        const EXTRA_ROTATION = 1.2; // radians of extra spin added over the exit

        // Sample easeInQuad(t/EXIT_SPAN) at N points so linear keyframe
        // interpolation reproduces the original continuous quadratic
        // closely enough to be visually indistinguishable — the
        // rate-limited chase (options.chase below) further smooths any
        // residual faceting.
        const ROTATION_SAMPLES = 9;
        const heroKeyframes = Array.from({ length: ROTATION_SAMPLES + 1 }, (_, i) => {
          const at = (i / ROTATION_SAMPLES) * EXIT_SPAN;
          const frac = Math.pow(at / EXIT_SPAN, 2);
          return { at, rotationYDelta: frac * EXTRA_ROTATION };
        });
        // First keyframe also carries the entrance shape/position origin;
        // last carries the hide shape. Keys are optional per keyframe (see
        // this file's own usage docs), so folding these onto the existing
        // rotation samples — rather than separate keyframe objects at the
        // same `at` — keeps one flat, readable timeline.
        //
        // 'terrain', not 'collapse' (a sphere) — restored to match the
        // ORIGINAL production behavior (see backup/partials/
        // particle-morph.hbs:814, kept for reference): "terrain, not
        // dispersed: the volatility lattice flowing into the terrain
        // relief reads as one continuous surface deforming" — the hero
        // shape and terrain are both flowing ground-plane surfaces, so the
        // hide reads as one shape continuing to deform rather than a hard
        // cut to something unrelated. 'collapse' was this session's own
        // interim choice; reverted here per explicit request. Only hero's
        // own hide shape changes — testimonials/operating-model-exit keep
        // 'collapse' (a separate, later, explicit decision unrelated to
        // hero's original value). The 'lab' zone below no longer has an
        // `at:0` shape claim mirroring this value (removed as part of the
        // self-contained-sections work — see that zone's own comment) so
        // there is nothing left here to track.
        const heroBaseShape = window.__heroShape ? window.__heroShape() : 'helix';
        heroKeyframes[0].position = [0, 0, 0];
        heroKeyframes[0].shape = heroBaseShape;
        heroKeyframes[0].shapeKey = 'hero';
        // heroKeyframes[heroKeyframes.length - 1].shape = 'dots'; // ALTERNATE — tried live, compared against 'terrain' below, for the run into the Lab/post-tabs section
        // 'terrain' ("surface" — see the comment above on why: the
        // volatility lattice flowing into the terrain relief reads as one
        // continuous surface deforming), back to the original shape after
        // comparing against 'dots' live. Still paired with 'hero-exit':'hide'
        // commented out in default.hbs's PARTICLE_SCENARIOS: with 'hide'
        // disabled, __particleApply's target falls back to this
        // builtinShape, so hero morphs into 'terrain' and STAYS VISIBLE,
        // rather than fading out (the pre-dots-experiment behavior DID fade
        // out at this same shape — see default.hbs's map for how to fully
        // revert to that if wanted). shapeKey still inherits the zone
        // default ('hero-exit') below, unaffected by the scenario-map change.
        heroKeyframes[heroKeyframes.length - 1].shape = 'terrain';
        // Captured (not hardcoded) so heroStillRelevant() below always
        // matches whichever shape this line above actually sets — swapping
        // 'dots'/'terrain'/anything else here no longer requires touching
        // that check too.
        const heroExitShape = heroKeyframes[heroKeyframes.length - 1].shape;

        // Shared by ownsPosition and frame() below — true while hero's own
        // shape (its base shape, or the 'terrain' ground plane it morphs
        // into) is still current AND the layer isn't hidden by some OTHER
        // trigger. Mirrors the deleted code's shapeHandedOff/
        // __particleLayerHidden check exactly. Re-reads window.__heroShape()
        // fresh each call (not the heroBaseShape captured above) to match
        // the deleted code's own behavior of never caching it.
        // 'dispersed' counts as hero's own: it is the landing cloud
        // system.start('dispersed') puts up BEFORE the hero morph, not a
        // hand-off to a later section. Without it here, hero declined
        // position ownership for the whole pre-morph window, so no zone was
        // the exclusive owner and Lab's clamped `at:0` keyframe
        // (position:[0,-6,0], an absolute write — see its setZone below) was
        // free to run: it is inside _zoneActive()'s 3-viewport margin while
        // you are still on the hero. That zeroed the canvas offset seeded at
        // particle creation, and the offset only reappeared once the morph
        // made the hero shape current and this check finally passed — a
        // one-frame sideways snap right after the shape finished forming.
        const heroStillRelevant = () => {
          const cur = loop.currentState;
          const base = window.__heroShape ? window.__heroShape() : 'helix';
          const handedOff = cur && cur.id !== base && cur.id !== heroExitShape && cur.id !== 'dispersed';
          return !(window.__particleLayerHidden || handedOff);
        };

        let heroFrameFrozen = null;
        window.particleScrollDirector.setZone('hero', heroKeyframes, {
          element: '.hero',
          mode: 'scroll-through',
          shapeKey: 'hero-exit',
          morphMs: 400,
          chase: { rotationYDelta: 0.05 },        // was particle-animation-loop.js's _heroExitRotationMaxDelta
          continuous: { rotationYDelta: 0.0025 }, // was _heroExitOverscrollSpinRate
          ownsPosition: heroStillRelevant,
          // positionBase/cameraZ/fov are DOM/viewport measurements, not
          // functions of `t` (canvas offset depends on live CSS custom
          // properties; FOV on viewport width) — see particle-scroll-
          // director.js's own doc on why these go through `frame()` rather
          // than plain keyframe channels: returning null once no longer
          // relevant is what lets some LATER section's own camera reset
          // stick, instead of this zone re-asserting a stale zoomed value
          // for as long as _zoneActive()'s generous margin keeps it live.
          frame: (l, t) => {
            if (!heroStillRelevant()) return null;
            if (t < EXIT_SPAN) {
              const off = l._getHeroCanvasOffset();
              const frac = Math.min(1, t / EXIT_SPAN);
              const zoomedZ = heroBaseCameraZ * ZOOM_FACTOR;
              heroFrameFrozen = {
                positionBase: [off.x, off.y + frac * TRAVEL_Y, 0],
                cameraZ: heroBaseCameraZ + (zoomedZ - heroBaseCameraZ) * (frac * frac),
                fov: l._getHeroZoomFov(window.innerWidth),
              };
            }
            return heroFrameFrozen;
          },
        });
      }

      // On cached/refresh visits, reveal particles immediately — no observer
      // needed. Fades the dedicated scrim (see its markup above), NOT
      // system.fadeController — that's shared with every other particle
      // transition on this page (scroll-triggered dissolve/assemble morphs,
      // hero-exit, etc. — see dissolveAndAssemble() in particle-morph-
      // system.js), so redirecting IT here would touch all of those too.
      // 150ms (the old duration, animating the canvas's own opacity via
      // fadeController) read as janky — likely the cost of animating
      // opacity on a WebGL canvas that's simultaneously re-rendering every
      // frame, on top of the particle system's own startup work. A flat
      // div's opacity is cheap regardless; slower/eased here reads as a
      // deliberate reveal instead of a rushed one.
      if (!window.__preloaderRunning) {
        const loadScrim = document.getElementById('particles-load-scrim');
        if (loadScrim) {
          if (window.gsap) {
            gsap.to(loadScrim, { opacity: 0, duration: 0.6, ease: 'power2.out' });
          } else {
            loadScrim.style.opacity = '0';
          }
        }
      }

      // Initialize Lab wave binding (scroll-driven particle color gradient +
      // orb deformation progress). A flat 50ms delay silently no-op'd here:
      // window.BackgroundLayer (a separate <script src>) frequently isn't
      // parsed/executed yet at 50ms on a cold load, and initLabWave() just
      // returns early when it's missing — nothing ever retried, so the
      // whole binding permanently never happened. Poll-and-retry instead
      // (same pattern already used for the hero helix-on-load and the work
      // page's dispersed-on-load fixes elsewhere in this codebase).
      //
      // Skipped entirely on low-end devices: its bindShift() binding attaches
      // a plain window 'scroll' listener that calls getBoundingClientRect()
      // on EVERY scroll event site-wide for the rest of the page's life,
      // regardless of whether the Lab section is anywhere near the
      // viewport — profiled under simulated old hardware as the single
      // largest source of scroll-jank on the page, dwarfing the particle
      // system itself. It would also never have any visible effect here
      // anyway, since low-end devices already skip the trigger that morphs
      // TO 'lab' in the first place (setupCardTriggers() isn't called).
      if (!window.__lowEndDevice) {
        // Was polling for BackgroundLayer.bindShift before calling this —
        // left over from when the Lab wavefront was scroll-scrubbed. It
        // became autonomous (a ping-pong in the loop's _rafCallbacks, see
        // initLabWave) and stopped using bindShift entirely, so the gate was
        // blocking on a dependency the function no longer has. It only ever
        // reads BackgroundLayer.parseColorToRGB for the accent sample, which
        // initLabWave already guards internally.
        debug('[particle-morph] Calling system.initLabWave()');
        system.initLabWave();

      // (work-cards — the post-card grid just above Lab — is the one
      // section-level particle trigger that's deliberately NOT a zone
      // here. See main.js's initCardParticleMorphing() for why: its shape
      // depends on "which sibling card is most visible," not a single
      // section's own monotonic scroll progress.)

      // LAB CHOREOGRAPHY — the sphere scrolls WITH its section.
      //
      // Every other particle behaviour on this page is positionally fixed:
      // the shape sits at the centre of a fixed, full-viewport canvas and
      // only its FORM changes as you scroll past. Here the object should
      // instead travel like a piece of the page — entering from below as
      // the Lab section does, riding up with it, leaving at the top.
      //
      // Bound to the .gradient-frame WRAPPER around the whole Lab island
      // (posts-tabs-grid-lab.hbs — it wraps the "Explorations, AI
      // experiments" statement heading AND #work-grid-lab together), not to
      // #work-grid-lab itself, so the sphere starts arriving as soon as
      // that heading's gradient band comes into view rather than waiting
      // for the card grid below it — asked for explicitly: "should come in
      // view much earlier, as soon as our gradient wrapper starts". Found
      // via closest() from #work-grid-lab rather than a bare
      // '.gradient-frame' selector since that class is reused elsewhere
      // (profile.hbs) and querying it directly could grab the wrong one.
      //
      // Position AND shape — the old IntersectionObserver that used to own
      // the morph to 'lab' (plus its ad hoc "scrolling up out of lab"
      // re-hide patch) is removed below in the same change, per the
      // director's own header comment about not running two shape-writers
      // for the same section at once.
      if (window.particleScrollDirector) {
        const labSection = document.querySelector('#work-grid-lab');
        const labWrapper = labSection && labSection.closest('.gradient-frame');
        if (labWrapper) {
          // World units: at camera z=8 / fov 75 the viewport is ~12.3 units
          // tall, so half that (~6.1) is the bottom edge. The start
          // keyframe sits just inside it (-6.0, not -7.0/off-screen) so the
          // sphere is already visibly emerging at the bottom the moment the
          // zone begins, per "should actually start at the bottom of the
          // screen, not off screen". Y increases upward, and content moves
          // up as you scroll down — hence negative (below) to positive
          // (above).
          //
          // Two phases: rise into place (0-0.50, same pace as before), then
          // a CONTINUOUS climb the rest of the way — no flat hold. A hold
          // was tried here and explicitly rejected: it should keep
          // scrolling up right until it's off-screen, not pause partway.
          // The second-half climb covers 14 units (not 7) over the same
          // 0.50 span, so it's moving at twice the original rate — faster
          // throughout, not just at the end — and it's already well past
