            element: labWrapper,
            morphMs: 800,
            // Release margin: t=1 is where the wrapper's OWN rect crosses
            // out of range (_zoneProgress()'s formula), but the object is
            // still comfortably on-screen there (see the t≈0.72 off-top-
            // edge note above) — releasing exactly at t=1 handed position
