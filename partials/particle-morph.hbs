        let heroFrameFrozen = null;
        window.particleScrollDirector.setZone('hero', heroKeyframes, {
          element: '.hero',
          mode: 'scroll-through',
          // .hero is 100dvh, so its own scroll-through progress hits 1.0
          // after a single viewport — but the object stays on screen for
          // roughly three viewports beyond that (measured live: rawT 3.15
          // at scrollY 2172 while t sat pinned at 1.0 from ~690 onward).
          // Without this, every keyframe `at` in 0-1 was crammed into the
          // first third of the visible scroll and the remaining ~1500px was
          // a dead zone where nothing could be scheduled at all — which is
          // why tuning EXIT_SPAN/SHAPE_EXIT_AT between 0.65 and 1.0
          // produced no visible change. 3.2 stretches the zone's 0-1 range
          // across the full distance the hero object is actually visible.
          progressScale: 8.2,
          shapeKey: 'hero-exit',
          morphMs: 800,
          // 0.05 -> 0.12: with rotation now LINEAR in scroll (was quadratic,
          // which started the target near-flat so the chase easily kept
          // up), a fast scroll flick's per-frame target delta could exceed
          // the old 0.05 cap, falling behind and then visibly catching up
          // afterward — read as "pause, then continues" even once scrolling
          // had already stopped/slowed. Raised so the chase can track the
          // linear target through normal-to-fast scroll speeds without
          // lagging; retune by watching it live if a very fast flick still
          // outruns it.
          chase: { rotationYDelta: 0.12 },        // was particle-animation-loop.js's _heroExitRotationMaxDelta
