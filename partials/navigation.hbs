{{!-- Animate the post-page nav collapse — but only on a genuine arrival
      from a non-post page. html.nav-hop (default.hbs head script) means
      we hopped here from another post via prev/next, which was already
      collapsed — nothing to animate, the CSS collapses it instantly pre-
      paint instead (see main.css "POST PAGE NAV"). Otherwise the nav
      renders expanded for a couple of frames on purpose (double rAF, so
      the browser has actually painted that expanded state at least once
      — a single rAF isn't reliably enough), then this adds the class that
      triggers the collapse transition, and a matching class afterward
      that removes .logoandnavwrapper from layout once the animation has
      actually finished (can't be part of the transition itself — display
      isn't animatable — doing it early would make the collapse look like
      it snaps partway through instead of shrinking smoothly). --}}
<script>
  (function () {
    // /work/ is a custom collection route (routes.yaml), not a real Ghost
    // Page — body_class renders empty there, so there's no server-side
    // class for the nav's "current page" CSS (main.css .nav-menu a) to
    // match, unlike home/about/contact which get real body classes.
    // Same pathname test already used for this exact page elsewhere
    // (particle-morph.hbs's isWorkIndexPage).
    if (/^\/work\/(page\/\d+\/)?$/.test(window.location.pathname)) {
      document.body.classList.add('page-work-index');
    }
  })();
</script>

{{!-- About/Contact close button — plain JS, not a second {{#is}}/{{#has}}
      branch in the markup above (that block's own comment explains why:
      {{> navigation}} sits outside any {{#post}}/{{#page}} context at its
      include point in default.hbs, so per-slug Handlebars checks have no
      data to match against there). Inserted BEFORE the collapse-trigger
      script below runs — that script measures .nav-wrapper's collapsed
      width by temporarily toggling nav-collapsing, which requires
      .nav-close-btn to already exist in the DOM or the measurement is
      wrong (missing this button's own width). Mirrors the real
      .nav-close-btn markup above exactly (same classes/icon/tooltip) so
      every CSS rule keyed off that class works identically regardless of
      which path created the element. --}}
<script>
  (function () {
    var isCloseablePage = document.body.classList.contains('page-about')
      || document.body.classList.contains('page-contact');
    if (!isCloseablePage) return;
    var navControls = document.querySelector('.nav-controls');
    if (!navControls || navControls.querySelector('.nav-close-btn')) return;
    var btn = document.createElement('button');
    btn.className = 'nav-icon-btn nav-close-btn';
    btn.setAttribute('aria-label', 'Close');
    btn.innerHTML = '<img src="{{asset "icons/close.svg"}}" alt="Close" class="nav-icon-close"><span class="nav-tooltip">Close</span>';
    navControls.insertBefore(btn, navControls.firstChild);
  })();
</script>

<script>
  (function () {
    if (document.documentElement.classList.contains('nav-hop')) return;
    // Same collapse-to-close-pill treatment now applies to About/Contact
    // (body.page-about / body.page-contact — Ghost's own page-slug body
    // classes), not just posts: same "close returns to wherever this was
    // opened from" behavior (page-transition.js's postOrigin/closePost(),
    // already generic — reads sessionStorage, no template gating in the
    // JS itself), just without prev/next (those stay post-only below —
    // "next about page" isn't a meaningful concept).
    var isPostOrCloseablePage = document.body.classList.contains('post-template')
      || document.body.classList.contains('page-about')
      || document.body.classList.contains('page-contact');
    if (!isPostOrCloseablePage) return;
    var wrapper = document.querySelector('.nav-wrapper');
    var logoAndNav = document.querySelector('.logoandnavwrapper');
    if (!wrapper || !logoAndNav) return;

    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        // Measure BOTH target widths as real DOM values, not hardcoded
        // pixel constants — main.css's HIDE-THEN-SHRINK model needs real
        // pixel numbers on both ends of the width transition (fit-content
        // can't be interpolated to OR from — confirmed in isolation), but
        // a literal number here would silently go stale if icon count/
        // gap/padding tokens ever change. Read at the double-rAF point:
        // the one true expanded frame, right before anything is hidden.
        var expandedWidth = wrapper.getBoundingClientRect().width;

        // Collapsed width: main.css gates close/.nav-post-controls behind
        // .nav-collapsing (so they don't render during this very
        // "expanded" frame and inflate expandedWidth above — see that
        // CSS block's own comment) — which means they're EQUALLY hidden
        // right now, before we've added that class. Temporarily add
        // nav-collapsing to reveal them (and hide logoandnavwrapper/
        // theme-toggle) for the measurement, then remove it immediately —
        // synchronous, no paint happens between add and remove, so this
        // never visibly flashes. The real (non-measurement) add happens a
        // few lines down.
        document.body.classList.add('nav-collapsing');
        var collapsedWidth = wrapper.getBoundingClientRect().width;
        document.body.classList.remove('nav-collapsing');

        wrapper.style.setProperty('--nav-expanded-w', expandedWidth + 'px');
        wrapper.style.setProperty('--nav-collapsed-w', collapsedWidth + 'px');

        // One more frame before flipping the target: a CSS transition
        // needs the browser to actually COMMIT the "before" value
        // (width: var(--nav-expanded-w), now a real px number instead of
        // fit-content) in a real paint before the target changes — doing
        // both in the same tick (confirmed in isolation while building
        // this) collapses them into one style recalc with no "before"
        // state to interpolate from, and the width just snaps.
        requestAnimationFrame(function () {
          document.body.classList.add('nav-collapsing');
        });
        // 550ms — matches the HIDE-THEN-SHRINK timing (main.css, "POST
        // PAGE NAV"): the pane's width transition (0.4s) and the
        // close/prev/next stagger (longest leg: Next, 0.16s delay + 0.3s
        // duration = 0.46s) both run concurrently from t=0, +buffer.
        // nav-collapsed-settled doesn't gate anything visual anymore —
        // logoandnavwrapper is already display:none the instant
        // nav-collapsing lands — it's kept only as a general "animation
        // finished" marker other code can check.
        setTimeout(function () {
          document.body.classList.add('nav-collapsed-settled');
        }, 550);
      });
    });
  })();
</script>
