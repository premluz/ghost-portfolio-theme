    <div class="nav-blur-layer nav-blur-layer-1"></div>
    <div class="nav-blur-layer nav-blur-layer-2"></div>
    <div class="nav-blur-layer nav-blur-layer-3"></div>
    <div class="nav-blur-layer nav-blur-layer-4"></div>
