{{!--
  LOGOS RIBBON
  Kinetic 3D-perspective marquee. Three-layer architecture:
    1. Section  — clipping viewport + 3D camera (perspective)
    2. Carrier  — over-wide container with rotateZ (diagonal) + rotateY (depth)
    3. Track    — flex logos, x-translated by GSAP for seamless infinite loop

  Future interaction: add [data-pullable] to any .logos-ribbon-item and wire up
  the pull-out hook at the bottom of the init script.

--}}


<section class="logos-ribbon-section" id="logos-ribbon" aria-label="Clients and collaborators">
  <div class="logos-ribbon-carrier">
    <div class="logos-ribbon-track" id="logosRibbonTrack">

      {{!-- ── Set A ─────────────────────────────────────────── --}}
      <div class="logos-ribbon-item" data-ribbon-logo="GalaChain">
        <img src="/content/images/logos/GalaChain.svg" alt="GalaChain" loading="lazy" draggable="false">
      </div>
      <div class="logos-ribbon-item" data-ribbon-logo="PlayStation">
        <img src="/content/images/logos/PlayStation.svg" alt="PlayStation" loading="lazy" draggable="false">
      </div>
      <div class="logos-ribbon-item" data-ribbon-logo="Vodafone">
        <img src="/content/images/logos/Vodafone.svg" alt="Vodafone" loading="lazy" draggable="false">
      </div>
      <div class="logos-ribbon-item" data-ribbon-logo="TheBodyShop">
        <img src="/content/images/logos/Tracr.svg" alt="The Body Shop" loading="lazy" draggable="false">
      </div>
      <div class="logos-ribbon-item" data-ribbon-logo="Deutsche_Bank">
        <img src="/content/images/logos/Deutsche_Bank.svg" alt="Deutsche Bank" loading="lazy" draggable="false">
      </div>

      {{!-- ── Set B — must be a byte-for-byte duplicate of Set A, same
             order, same count. The wrap math (halfWidth = scrollWidth/2)
             only produces a seamless loop if both halves are pixel-identical
             — anything else (different item count/order, like the stray
             extra Vodafone this used to have) turns the "seamless" wrap
             into a visible jump every cycle, since shifting by "half" no
             longer lands on an identical frame. ───────────────────── --}}
      <div class="logos-ribbon-item" data-ribbon-logo="GalaChain">
        <img src="/content/images/logos/GalaChain.svg" alt="GalaChain" loading="lazy" draggable="false">
      </div>
      <div class="logos-ribbon-item" data-ribbon-logo="PlayStation">
        <img src="/content/images/logos/PlayStation.svg" alt="PlayStation" loading="lazy" draggable="false">
      </div>
      <div class="logos-ribbon-item" data-ribbon-logo="Vodafone">
        <img src="/content/images/logos/Vodafone.svg" alt="Vodafone" loading="lazy" draggable="false">
      </div>
      <div class="logos-ribbon-item" data-ribbon-logo="TheBodyShop">
        <img src="/content/images/logos/Tracr.svg" alt="The Body Shop" loading="lazy" draggable="false">
      </div>
      <div class="logos-ribbon-item" data-ribbon-logo="Deutsche_Bank">
        <img src="/content/images/logos/Deutsche_Bank.svg" alt="Deutsche Bank" loading="lazy" draggable="false">
      </div>

    </div>

  </div>

</section>

