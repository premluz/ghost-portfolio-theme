{{!--
  PROFILE SECTION
  Mirrored from the HERO SECTION partial.
  Custom fields (set in Ghost Admin › Design):
    @custom.profile_name        — top label
    @custom.profile_title       — main headline
    @custom.profile_description — supporting paragraph
    @custom.profile_bullet_1/2/3 — tag pills
    @custom.profile_image       — portrait / right-side image (falls back to site cover)
--}}


<section
  class="case-study-section"
  data-gradient-position="outer"
  data-gradient-wash-bottom="md"
  data-gradient-wash-top="sm"
  data-background=""
  data-gradient-wash=""

>

  <div
    class="case-study-columns"
    data-cols="2"
    data-width="contained"
    data-col-widths="1/1"
  >
    <div class="case-study-item" data-align="top">

           <h2>
            {{#if @custom.profile_title}}
              {{@custom.profile_title}}
            {{else}}
              The design role is shifting.
            {{/if}}
          </h2>

            <p data-card-reveal="default">
              AI has collapsed the distance between idea and working product.
              What's left scarce is judgment. That's the model I work in.
            </p>



      </div>

         <div class="case-study-item" data-align="top">

         <div class="field-grid mt-prose-flow-lg" data-cols="1"  data-card="none">

        <div class="field-grid-item">
          <h3 class="mt-0 mb-0">Partner</h3>
          <p class="mt-0">
            With engineers, product and executives, in their language.
            Influence earned by work.
          </p>
        </div>

        <div class="field-grid-item">
          <h3 class="mt-0 mb-0">Lead</h3>
          <p>
            Hands-on at one end; mentoring, vision and design ops at the other.
          </p>
        </div>

        <div class="field-grid-item">
          <h3 class="mt-0 mb-0">Build</h3>
          <p>
            Close to code. Complex products and systems.
          </p>
        </div>

        <div class="field-grid-item">
          <h3 class="mt-0 mb-0">Care</h3>
          <p>
            Judgment, empathy, craft, coherence. That part stays human.
          </p>
        </div>

        <div class="field-grid-item">
          <h3 class="mt-0 mb-0">Remove</h3>
          <p>
            More than I add. Killing bolt-ons and scope creep before they ship.
          </p>
        </div>

        <div class="field-grid-item">
          <h3 class="mt-0">Deliver</h3>
          <p>
            Value from day one, across 0→1→growth.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
